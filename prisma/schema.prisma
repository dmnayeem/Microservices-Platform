  description     String                   @db.Text
  // Free-form category retained for back-compat (existing rows). New listings
  // should use assetType + subType instead. See src/lib/marketplace-categories.ts.
  category        String
  // Typed asset taxonomy. Drives the dynamic listing form + per-category
  // commission. Defaults to "DIGITAL_PRODUCT" so legacy rows stay valid.
  assetType       String                   @default("DIGITAL_PRODUCT")
  subType         String?
  // Category-specific structured data (mirrors customConfig pattern on Task).
  details         Json?
  price           Decimal @db.Decimal(18, 6)
  currency        String                   @default("USD")
  images          String[]
  // Proof-of-asset screenshots (Search Console, analytics, ad dashboards,
  // payout history). Kept separate from `images` (which is the marketing gallery).
  screenshots     String[]
  // PDFs, traffic reports, P&L docs.
  attachments     String[]
  files           String[]
  // Long-form description (markdown). Short `description` stays for cards/list.
  richDescription String?                  @db.Text
  // Asset financials (where relevant — null for non-monetized assets).
  monthlyRevenue  Decimal? @db.Decimal(18, 6)
  monthlyProfit   Decimal? @db.Decimal(18, 6)
  monthlyExpenses Decimal? @db.Decimal(18, 6)
  monthlyTraffic  Int?
  assetAgeMonths  Int?
  niche           String?
  reasonsForSelling String?                @db.Text
  whatsIncluded   String?                  @db.Text
  whatsNotIncluded String?                 @db.Text
  // Admin-set after reviewing proof screenshots. Surfaces a green badge.
  verifiedMetrics Boolean                  @default(false)
  // Adult / quarantined content. Hidden from default browsing.
  nsfw            Boolean                  @default(false)
  // Revenue figures hidden until buyer signs an NDA.
  ndaGated        Boolean                  @default(false)
  // Auction support. When false the listing is fixed-price buy-now only.
  auctionMode     Boolean                  @default(false)
  startingBid     Decimal? @db.Decimal(18, 6)
  reservePrice    Decimal? @db.Decimal(18, 6)
  buyNowPrice     Decimal? @db.Decimal(18, 6)
  auctionEndsAt   DateTime?
  isFeatured      Boolean                  @default(false)
  featuredUntil   DateTime?
  isPromoted      Boolean                  @default(false)
  promotedUntil   DateTime?
  // Override platform commission in basis points (100 bps = 1%).
  // Falls back to setting `marketplace_commission_rates` when null.
  commissionRateBps Int?
  // Seller-set affiliate reward paid (from the seller's own cut) to an affiliate
  // who drives a sale. type = "PERCENT" (value = % of sale) | "FIXED" (value =
  // USD). null / 0 ⇒ not affiliate-eligible. See src/lib/affiliate.ts.
  affiliateCommissionType  String?
  affiliateCommissionValue Decimal? @db.Decimal(18, 6)
  // Pre-aggregated counters for fast list rendering.
  bidsCount       Int                      @default(0)
  bidderCount     Int                      @default(0)
  uniqueViewers   Int                      @default(0)
  directPurchasesCount Int                 @default(0)
  // Seller-listing moderation (admin approve/reject). New user listings start
  // PENDING_REVIEW; rejection stores a reason shown back to the seller.
  rejectionReason String?                  @db.Text
  reviewedAt      DateTime?
  reviewedById    String?
  // Extracted micro-data of the uploaded deliverable (stock media): EXIF,
  // codec/duration, hash, perceptual hash + heuristic hints. Surfaced to the
  // admin to judge original vs downloaded/edited. See src/lib/media-metadata.ts.
  fileMeta        Json?
  status          MarketplaceListingStatus @default(ACTIVE)
  views           Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  expiresAt       DateTime?
  purchases       MarketplacePurchase[]
  cartItems       CartItem[]
  watches         MarketplaceWatch[]
  viewLog         MarketplaceListingView[]
  bids            MarketplaceBid[]
  offers          MarketplaceOffer[]
  threads         MarketplaceThread[]
  deals           MarketplaceDeal[]
  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([assetType])
  @@index([isFeatured])
}

model MarketplacePurchase {
  id          String             @id @default(cuid())
  listingId   String
  listing     MarketplaceListing @relation(fields: [listingId], references: [id])
  buyerId     String
  buyer       User               @relation(fields: [buyerId], references: [id])
  amount      Decimal @db.Decimal(18, 6)
  fee         Decimal @db.Decimal(18, 6)
  sellerAmount Decimal @db.Decimal(18, 6)
  status      String             @default("COMPLETED")
  createdAt   DateTime           @default(now())
  disputes    MarketplaceDispute[]
  @@index([listingId])
  @@index([buyerId])
}

// Buyer↔seller conversation scoped to a listing. An admin can join a thread to
// mediate a deal (membership checked in the API, not by a relation). One thread
// per buyer per listing. User IDs are bare (mirrors MarketplaceDispute) so the
// User model stays untouched.
model MarketplaceThread {
  id              String                     @id @default(cuid())
  listingId       String
  listing         MarketplaceListing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId         String
  sellerId        String
  assignedAdminId String?
  lastMessageAt   DateTime                   @default(now())
  unreadBuyer     Int                        @default(0)
  unreadSeller    Int                        @default(0)
  createdAt       DateTime                   @default(now())
  messages        MarketplaceThreadMessage[]
  deals           MarketplaceDeal[]
  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([lastMessageAt])
}

model MarketplaceThreadMessage {
  id          String            @id @default(cuid())
  threadId    String
  thread      MarketplaceThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  senderType  String            @default("USER") // USER, ADMIN, SYSTEM
  body        String            @db.Text
  attachments String[]
  createdAt   DateTime          @default(now())
  @@index([threadId])
  @@index([senderId])
}

// Full-escrow deal on a thread. Buyer funds `amount` (+ optional `adminFee` on
// top when admin-mediated); funds are held (`heldAmount`) until RELEASED to the
// seller or REFUNDED to the buyer. On RELEASE a MarketplacePurchase row is
// created (`purchaseId`) so the existing download-gate + orders views work.
model MarketplaceDeal {
  id              String                @id @default(cuid())
  threadId        String
  thread          MarketplaceThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  listingId       String
  listing         MarketplaceListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId         String
  sellerId        String
  proposedById    String
  amount          Decimal               @db.Decimal(18, 6)
  status          MarketplaceDealStatus @default(PROPOSED)
  adminMediated   Boolean               @default(false)
  adminFee        Decimal               @default(0) @db.Decimal(18, 6)
  assignedAdminId String?
  heldAmount      Decimal               @default(0) @db.Decimal(18, 6)
  commissionBps   Int?
  // Affiliate attribution captured at funding time (buyer's cookie); paid out of
  // the seller's cut on release, mirroring the instant-checkout affiliate path.
  affiliateUserId String?
  affiliateAmount Decimal               @default(0) @db.Decimal(18, 6)
  purchaseId      String?
  autoReleaseAt   DateTime?
  deliveredAt     DateTime?
  confirmedAt     DateTime?
  releasedAt      DateTime?
  refundedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  @@index([threadId])
  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([assignedAdminId])
  @@index([autoReleaseAt])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

// Users can "watch" listings — soft favorites that surface in seller analytics
// ("12 people are watching this listing").
model MarketplaceWatch {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  watchedAt DateTime           @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
  @@index([userId])
}

// Per-view audit row for marketplace listing analytics. The viewer can be
// anonymous (sessionHash dedupes). Phase-4 charts read from this table; the
// hot `uniqueViewers` counter on MarketplaceListing is incremented when this
// is the user's first row.
model MarketplaceListingView {
  id          String             @id @default(cuid())
  listingId   String
  listing     MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionHash String
  source      String?
  viewedAt    DateTime           @default(now())

  @@unique([listingId, sessionHash])
  @@index([listingId])
  @@index([viewedAt])
}

// A bid in an auction-mode listing. Only one ACTIVE bid exists per listing at
// any time; placing a higher bid moves the previous ACTIVE row to OUTBID and
// notifies the prior bidder.
model MarketplaceBid {
  id        String               @id @default(cuid())
  listingId String
  listing   MarketplaceListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User                 @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amount    Decimal @db.Decimal(18, 6)
  status    MarketplaceBidStatus @default(ACTIVE)
  message   String?              @db.Text
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([listingId])
  @@index([bidderId])
  @@index([listingId, status])
}

// A "make an offer" submission. Independent of auction bids — a buyer can
// offer any amount; the seller accepts / rejects / counters. Accepting an
// offer turns it into a MarketplacePurchase at the agreed price.
model MarketplaceOffer {
  id            String                 @id @default(cuid())
  listingId     String
  listing       MarketplaceListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User                   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amount        Decimal @db.Decimal(18, 6)
  message       String?                @db.Text
  status        MarketplaceOfferStatus @default(PENDING)
  counterAmount Decimal? @db.Decimal(18, 6)
  counterMessage String?               @db.Text
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([listingId, status])
}

model Course {
  id              String        @id @default(cuid())
  title           String
  slug            String?       @unique
  subtitle        String?
  description     String        @db.Text
  thumbnail       String?
  bannerUrl       String?
  promoVideoUrl   String?
  category        String
  categoryId      String?
  category_rel    CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId   String?
  subcategory_rel CourseSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  difficulty      String        @default("BEGINNER")
  skillLevel      CourseSkillLevel @default(BEGINNER)
  language        String        @default("en")
  price           Decimal         @default(0) @db.Decimal(18, 6)
  originalPrice   Decimal? @db.Decimal(18, 6)
  discountPrice   Decimal? @db.Decimal(18, 6)
  discountEndsAt  DateTime?
  isFree          Boolean       @default(false)
  totalLessons    Int           @default(0)
  totalDuration   Int           @default(0)
  status          CourseStatus  @default(DRAFT)
  enrollmentCount Int           @default(0)
  rating          Float         @default(0)
  totalRatings    Int           @default(0)
  avgRating       Float         @default(0)
  totalReviews    Int           @default(0)
  totalQuestions  Int           @default(0)
  totalRevenueCents Int         @default(0)
  uniqueViewers   Int           @default(0)
  learningOutcomes String[]     @default([])
  requirements    String[]      @default([])
  whatsIncluded   String[]      @default([])
  faqs            Json?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String[]      @default([])
  tutorId         String?
  tutor           User?         @relation("CourseTutor", fields: [tutorId], references: [id], onDelete: SetNull)
  certificateEnabled Boolean    @default(true)
  commissionRateBps Int?
  // Tutor-set affiliate reward (from the tutor's cut) — see MarketplaceListing.
  affiliateCommissionType  String?
  affiliateCommissionValue Decimal? @db.Decimal(18, 6)
  isFeatured      Boolean       @default(false)
  featuredUntil   DateTime?
  isPromoted      Boolean       @default(false)
  promotedUntil   DateTime?
  nsfw            Boolean       @default(false)
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?
  lastContentUpdate DateTime?
  modules         CourseModule[]
  lessons         CourseLesson[]
  enrollments     CourseEnrollment[]
  reviews         CourseReview[]
  questions       CourseQuestion[]
  bookmarks       CourseBookmark[]
  announcements   CourseAnnouncement[]
  quizzes         CourseQuiz[]
  assignments     CourseAssignment[]
  liveClasses     CourseLiveClass[]
  certificates    CourseCertificate[]
  refundRequests  CourseRefundRequest[]
  views           CourseListingView[]
  @@index([status])
  @@index([category])
  @@index([categoryId])
  @@index([tutorId])
  @@index([isFeatured])
  @@index([slug])
}

model CourseCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconKey     String?
  color       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subcategories CourseSubcategory[]
  courses     Course[]
  @@index([isActive])
  @@index([order])
}

model CourseSubcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  courses    Course[]
  @@unique([categoryId, slug])
  @@index([categoryId])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     CourseLesson[]
  @@index([courseId])
}

model CourseLesson {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  content      String?  @db.Text
  videoUrl     String?
  subtitlesUrl String?
  transcript   String?  @db.Text
  duration     Int      @default(0)
  order        Int
  isFree       Boolean  @default(false)
  isPreview    Boolean  @default(false)
  lessonType   CourseLessonType @default(VIDEO)
  resources    Json?
  quizId       String?
  quiz         CourseQuiz? @relation("LessonQuiz", fields: [quizId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   CourseAssignment? @relation("LessonAssignment", fields: [assignmentId], references: [id], onDelete: SetNull)
  liveClassId  String?
  liveClass    CourseLiveClass? @relation("LessonLive", fields: [liveClassId], references: [id], onDelete: SetNull)
  progress     CourseLessonProgress[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([courseId])
  @@index([moduleId])
}

model CourseEnrollment {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  progress        Int      @default(0)
  completedLessons String[] @default([])
  completedAt     DateTime?
  pricePaid       Decimal    @default(0) @db.Decimal(18, 6)
  couponCode      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lessonProgress  CourseLessonProgress[]
  refundRequests  CourseRefundRequest[]
  @@unique([courseId, userId])
  @@index([userId])
}

model CourseLessonProgress {
  id             String   @id @default(cuid())
  enrollmentId   String
  enrollment     CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  watchedSeconds Int      @default(0)
  totalSeconds   Int      @default(0)
  isCompleted    Boolean  @default(false)
  lastPosition   Int      @default(0)
  notes          Json?
  bookmarks      Json?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
}

model CourseReview {
  id           String   @id @default(cuid())
