model Lottery {
  id                String          @id @default(cuid())
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime
  drawDate          DateTime
  ticketPrice       Int
  maxTickets        Int?
  ticketsSold       Int             @default(0)
  maxTicketsPerUser Int             @default(10)
  /// FIXED mode only: [{position, amount, description}] absolute point amounts.
  prizes            Json
  status            LotteryStatus   @default(UPCOMING)
  /// legacy, unused — generated and stored but the draw never read it.
  winningNumbers    String?
  winners           Json?

  // ── Prize mode ───────────────────────────────────────────────────────────
  prizeMode       LotteryPrizeMode @default(FIXED)
  /// POOL mode only: [{position, percent, description}] shares of the pool.
  /// Deliberately a SEPARATE column from `prizes` — overloading `amount` as a
  /// percent would make every existing `reduce(sum, p.amount)` reader render a
  /// percentage as a points total.
  prizeTiers      Json?
  /// 0-90. Taken off GROSS TICKET SALES only — never the seed, never rolled-in
  /// points (those were already cut at their source).
  houseCutPercent Int              @default(0)
  /// Platform-funded floor so an under-sold pool draw isn't insulting.
  poolSeedPoints  Int              @default(0)
  /// Liability ceiling. Anything above it is recorded as overflow to house.
  poolCapPoints   Int?

  // ── Minimum tickets / rollover ───────────────────────────────────────────
  /// 0 = no floor.
  minTickets       Int                    @default(0)
  shortfallAction  LotteryShortfallAction @default(DRAW)
  /// Where the pot goes on ROLLOVER. Validated at draw time; if it is no longer
  /// usable the draw degrades to REFUND rather than stranding user money.
  rolloverTargetId String?
  /// Carried IN from a lottery that rolled over into this one.
  rolloverInPoints Int                    @default(0)
  rolloverFromId   String?

  settlement LotterySettlement?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tickets           LotteryTicket[]

  @@index([status])
  @@index([drawDate])
  @@index([status, drawDate])
}

/// Immutable accounting record for a finished lottery — created once, never
/// updated (there is no update path, and `@@unique(lotteryId)` is a second
/// idempotency guard behind the draw's status CAS).
///
/// Before this, a COMPLETED lottery recorded nothing about what the pot was
/// worth or what the platform kept, which makes POOL mode unauditable. Finance
/// reporting reads THIS table, not `Lottery` — points the house never credits
/// are the house's margin, so there is no ledger row to count.
model LotterySettlement {
  id        String  @id @default(cuid())
  lotteryId String  @unique
  lottery   Lottery @relation(fields: [lotteryId], references: [id], onDelete: Cascade)

  outcome   LotteryOutcome
  prizeMode LotteryPrizeMode

  ticketsSold      Int
  ticketPrice      Int
  grossSalesPoints Int @default(0)
  houseCutPercent  Int @default(0)
  houseCutPoints   Int @default(0)
  seedPoints       Int @default(0)
  rolloverInPoints Int @default(0)
  /// The pool as computed at draw time — the number the winners were paid from.
  prizePoolPoints  Int @default(0)
  paidOutPoints    Int @default(0)
  refundedPoints   Int @default(0)
  rolledOverPoints Int @default(0)
  /// Amount above `poolCapPoints` the house kept.
  overflowToHouse  Int @default(0)

  rolloverToId String?
  /// The EFFECTIVE tiers used (after re-normalising for ticket count).
  tiers        Json?
  winners      Json?
  /// sha256 of the shuffled ticket-id order — a post-hoc fairness record.
  drawOrderHash String?

  settledAt DateTime @default(now())

  @@index([outcome, settledAt])
  @@index([rolloverToId])
}

model LotteryTicket {
  id           String   @id @default(cuid())
  lotteryId    String
  lottery      Lottery  @relation(fields: [lotteryId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  ticketNumber String
  numbers      String?
  isWinner     Boolean  @default(false)
  prizeAmount  Int?
  createdAt    DateTime @default(now())

  @@unique([lotteryId, ticketNumber])
  @@index([lotteryId])
  @@index([userId])
  @@index([lotteryId, userId])
  @@index([userId, createdAt])
  // Public "recent winners" list — isWinner was unindexed.
  @@index([isWinner, createdAt])
  @@index([userId, isWinner])
}

model Post {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id])
  content               String          @db.Text
  images                String[]
  // Facebook-style colored background for text-only posts. Stores a palette id
  // from src/lib/post-backgrounds.ts (e.g. "ocean"); null = plain post.
  backgroundStyle       String?
  isPublic              Boolean         @default(true)
  isPinned              Boolean         @default(false)
  // Soft-moderation: hidden by an agency moderator (kept for audit, excluded from feed)
  isHidden              Boolean         @default(false)
  // Admin-set OFFICIAL announcement. Pinned to the very top of the feed
  // and shown with an OFFICIAL badge. Created via /api/admin/feed/announce.
  isAnnouncement        Boolean         @default(false)
  // Admin-set PROMOTED post. Appears with a PROMOTED badge and is
  // interleaved through the feed. Auto-expires when promotedUntil < now().
  isPromoted            Boolean         @default(false)
  promotedUntil         DateTime?
  // Optional sponsor name shown next to the PROMOTED badge (e.g. "NordVPN").
  promotedNote          String?         @db.VarChar(120)
  // User self-serve boost: while > now() the post recirculates near the top of
  // the feed (not a permanent pin), capped per-viewer via PostBoostView.
  boostedUntil          DateTime?
  boostViews            PostBoostView[]
  likesCount            Int             @default(0)
  commentsCount         Int             @default(0)
  sharesCount           Int             @default(0)
  viewsCount            Int             @default(0)
  // Link-click report (owner-only): total clicks (spam-guarded by a short
  // cooldown) and distinct clickers (one per user, via PostLinkClick).
  linkClicksCount       Int             @default(0)
  uniqueLinkClicksCount Int             @default(0)
  socialEarnings        Int             @default(0)
  pollOptions           Json? // [{ id, label, voteCount }]
  pollEndsAt            DateTime?
  // OpenGraph preview of the first URL in `content`, fetched best-effort at
  // create time: { url, title, description, image, siteName }. Null = no card.
  linkPreview           Json?
  donationGoal          Int?
  donationCollected     Int             @default(0)
  groupId               String?
  // Optional relation → Prisma's implicit `onDelete: SetNull`. Deleting a group
  // would therefore null `groupId` on its posts, and a post whose `isPublic`
  // defaults to true would surface in the PUBLIC feed. There is no group-delete
  // route today, so this is latent, not live — but anything that adds one must
  // decide the posts' fate explicitly rather than inherit this.
  group                 Group?          @relation(fields: [groupId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  // Freshness signal for the smart feed: bumped when a new comment arrives so
  // the post resurfaces. Defaults to createdAt for new/legacy rows.
  lastActivityAt        DateTime        @default(now())
  comments              Comment[]
  likes                 Like[]
  votes                 Vote[]
  donations             Donation[]
  views                 PostView[]
  linkClicks            PostLinkClick[]
  shares                PostShare[]
  mentions              Mention[]
  adPromotions          Ad[]            @relation("PostAds")

  @@index([userId])
  @@index([createdAt])
  @@index([groupId])
  @@index([isAnnouncement])
  @@index([isPromoted, promotedUntil])
  @@index([boostedUntil])
  @@index([isPublic, createdAt])
  @@index([isPublic, isHidden, isPinned, createdAt])
  @@index([isPublic, isHidden, lastActivityAt])
  // Main feed: filters on four booleans, sorts by [isPinned, lastActivityAt].
  // The existing [isPublic, isHidden, lastActivityAt] omits isPinned, so Postgres
  // had to sort every matching row instead of walking an index.
  @@index([isPublic, isHidden, isAnnouncement, isPromoted, isPinned, lastActivityAt])
  // Profile timelines + the per-day post-limit count on every new post.
  @@index([userId, createdAt])
  @@index([userId, isPublic, isHidden, createdAt])
}

