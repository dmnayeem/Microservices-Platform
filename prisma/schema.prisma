  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([conversationId, createdAt])
}

// Reference data backing the cascading address dropdowns. Seeded once and
// editable by admin. User profile address fields stay as flat string columns
// — these tables only drive the dropdown UI; they don't replace the User
// fields.
model Country {
  id            String     @id @default(cuid())
  iso2          String     @unique
  iso3          String?    @unique
  name          String     @unique
  phoneCode     String?
  flag          String?
  currency      String?
  isActive      Boolean    @default(true)
  // Which dropdown levels render for this country, in user-facing order.
  // E.g. BD = ["DIVISION","DISTRICT","SUB_DISTRICT","CITY"], US = ["STATE","CITY"].
  // Empty = no DB-backed dropdowns; all address fields fall back to free text.
  enabledLevels String[]   @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  locations     Location[]

  @@index([isActive, name])
}

model Location {
  id         String     @id @default(cuid())
  countryId  String
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   Location[] @relation("LocationHierarchy")
  name       String
  // STATE | REGION | DIVISION | SUB_DIVISION | DISTRICT | SUB_DISTRICT | CITY | VILLAGE
  type       String
  postalCode String?
  metadata   Json?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([countryId, parentId, name, type])
  @@index([countryId, type, isActive])
  @@index([parentId, type, isActive])
  @@index([name])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String   @default("general")
  description String?
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// Super-admin-defined role: any name + a chosen permission set. Assigned to
// users via customRoleId (their enum role stays ADMIN as the admin baseline).
// Permissions never include finance or admins.manage (stripped on save + in the
// effective-permission resolver).
model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  color       String?
  permissions String[] @default([])
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// Public contact-form submissions (from /contact). Stored server-side and
// optionally emailed to support when SMTP is configured.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  category  String?
  message   String   @db.Text
  ipAddress String?
  status    String   @default("NEW") // NEW | READ | RESOLVED
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model OfferwallConfig {
  id          String   @id @default(cuid())
  provider    String   @unique
  isActive    Boolean  @default(false)
  apiKey      String?
  secretKey   String?
  callbackUrl String?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Internal offerwall catalog (curated + provider-synced offers) ──
// Loose coupling (plain userId/providerId strings, no User FK) matches the
// existing OfferwallCallback style. Offers are grouped into categories and
// completed one-by-one (sequential unlock via `order`), country-targeted,
// with per-offer points + completion mode (proof / postback / manual).
model OfferwallCategory {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  icon        String?
  color       String?
  order       Int              @default(0)
  isActive    Boolean          @default(true)
  offers      OfferwallOffer[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, order])
}

model OfferwallOffer {
  id                  String                @id @default(cuid())
  categoryId          String
  category            OfferwallCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title               String
  description         String?               @db.Text
  instructions        String[] // ordered steps shown to the user
  imageUrl            String?
  points              Int                   @default(0)
  payoutUsd           Decimal?              @db.Decimal(18, 6)
  countries           String[]              @default([]) // empty = all countries
  order               Int                   @default(0) // sequential-unlock order within the category
  trackingUrlTemplate String?               @db.Text // Start Work destination; supports {userId}/{clickId}
  source              String                @default("MANUAL") // MANUAL | PROVIDER
  providerId          String? // OfferwallConfig.id when source = PROVIDER
  externalOfferId     String? // provider's offer id (postback match + sync upsert)
  completionMode      String                @default("PROOF") // PROOF | POSTBACK | MANUAL
  proofScreenshot     Boolean               @default(true)
  dailyLimit          Int?
  oneTimePerUser      Boolean               @default(true)
  holdHours           Int                   @default(0)
  featured            Boolean               @default(false)
  isActive            Boolean               @default(true)
  completions         OfferwallCompletion[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([isActive, categoryId, order])
  @@index([providerId, externalOfferId])

  // Foreign key with no covering index — Postgres does not create one,
  // so both the join and the parent-delete referential check were scans.
  @@index([categoryId])
}

// One "Start Work" click — the subid glue matched by the provider postback.
model OfferwallClick {
  id        String   @id @default(cuid()) // = clickId / subid passed into the tracking URL
  userId    String
  offerId   String
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, offerId])
  @@index([createdAt])
}

model OfferwallCompletion {
  id              String         @id @default(cuid())
  userId          String
  offerId         String
  offer           OfferwallOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  categoryId      String?
  status          String         @default("STARTED") // STARTED | PENDING | APPROVED | REJECTED | REVERSED
  proofImages     String[]
  points          Int            @default(0)
  payoutUsd       Decimal?       @db.Decimal(18, 6)
  providerId      String?
  txid            String? // provider transaction id (postback dedup)
  clickId         String?
  reviewedById    String?
  reviewNote      String?        @db.Text
  rejectionReason String?        @db.Text
  heldUntil       DateTime?
  creditedAt      DateTime?
  reversedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Postback idempotency. (providerId,txid) both-null rows are allowed for
  // proof/manual completions since Postgres treats NULLs as distinct.
  @@unique([providerId, txid])
  @@index([userId, status])
  @@index([offerId, status])
  @@index([status, heldUntil])
}

model VideoAdConfig {
  id        String   @id @default(cuid())
  provider  String   @unique
  isActive  Boolean  @default(false)
  appId     String?
  adUnitId  String?
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String? // the ACTOR (admin/user who performed the action)
  action    String
  entity    String
  entityId  String?
  // The user AFFECTED by the action (e.g. the user an admin gave points to /
  // whose submission was approved). Powers the Admin & User Activity views.
  targetUserId String?
  // Human-readable one-liner for the activity feeds (e.g. "Gave 500 pts").
  summary   String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([targetUserId, createdAt])
  @@index([action])
  // Every audit read filters then sorts by createdAt; the filter and the sort
  // lived in separate indexes, so Postgres bitmap-and'd and re-sorted.
  @@index([userId, createdAt])
  @@index([entity, createdAt])
  @@index([userId, action, entity])
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
  ESCALATED
}

enum DisputeReason {
  ITEM_NOT_RECEIVED
  ITEM_NOT_AS_DESCRIBED
  PAYMENT_ISSUE
  SELLER_UNRESPONSIVE
  BUYER_UNRESPONSIVE
  QUALITY_ISSUE
  OTHER
}

model MarketplaceDispute {
  id              String              @id @default(cuid())
  purchaseId      String
  purchase        MarketplacePurchase @relation(fields: [purchaseId], references: [id])
  initiatorId     String // User who initiated the dispute (buyer or seller)
  initiatorType   String              @default("BUYER") // BUYER or SELLER
  reason          DisputeReason
  description     String              @db.Text
  evidence        String[] // Array of evidence image/file URLs
  status          DisputeStatus       @default(OPEN)
  resolution      String?             @db.Text
  resolvedAmount  Decimal?            @db.Decimal(18, 6) // Amount returned to buyer if any
  assignedAdminId String?
  adminNotes      String?             @db.Text
  messages        DisputeMessage[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  resolvedAt      DateTime?

  @@index([purchaseId])
  @@index([initiatorId])
  @@index([status])
  @@index([createdAt])
}

model DisputeMessage {
  id          String             @id @default(cuid())
  disputeId   String
  dispute     MarketplaceDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId    String
  senderType  String             @default("USER") // USER, ADMIN, SYSTEM
  message     String             @db.Text
  attachments String[]
  createdAt   DateTime           @default(now())

  @@index([disputeId])
  @@index([senderId])
}

enum MediaFileType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

model Media {
  id               String        @id @default(cuid())
  filename         String // Server-generated filename
  originalFilename String // Original filename from user
  fileType         MediaFileType @default(IMAGE)
  mimeType         String
  fileSize         Int // File size in bytes
  s3Key            String        @unique // S3 object key
  s3Url            String // Direct S3 URL
  cloudFrontUrl    String? // CloudFront CDN URL (optional)
  altText          String?
  caption          String?       @db.Text
  description      String?       @db.Text
  folder           String        @default("") // Optional path-style folder, e.g. "banners" or "2026/april"
  width            Int? // Image/video width in pixels
  height           Int? // Image/video height in pixels
  duration         Int? // Video/audio duration in seconds
  uploadedById     String
  uploadedBy       User          @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([uploadedById])
  @@index([fileType])
  @@index([folder])
  @@index([createdAt])
  @@index([s3Key])
}

// ── Page/traffic analytics ──────────────────────────────────────────────────
// Per-day rollup of page & task-page traffic (views, unique visitors, dwell).
// Modeled on AdDailyStat: written by a best-effort upsert-increment; never
// pruned (aggregate kept long-term). `kind`: "PAGE" (normalized route template)
// or "TASK" (individual task id, with `label` = task type).
model PageDailyStat {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  kind           String // "PAGE" | "TASK"
  key            String // normalized route template, or task id
  label          String? // task type for kind=TASK
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  totalDwellSec  Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([kind, key, date])
  @@index([kind, date])
  @@index([date])
}

// Raw per-visitor dedup rows so unique-visitor counts stay correct. Append-only,
// pruned by log-retention (the `views` window). visitorHash = sha256(userId||ip:ua).
model PageVisitDaily {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  kind        String
  key         String
  visitorHash String
  createdAt   DateTime @default(now())

  @@unique([kind, key, date, visitorHash])
  @@index([createdAt])
}

// ── Events / Quests (feature #10) ────────────────────────────────────────────
// Admin-authored, time-boxed challenges: hit a target action count within the
// window → claim a reward.
//
// Progress is a FORWARD-ONLY counter written at the moment the action happens
// (src/lib/event-progress.ts), deduped by EventActionLog. It used to be
// recomputed on read by counting rows in shared activity tables over
// [startAt … now], so whatever a user had already done counted the instant an
// event was published — the Claim button could be green before they had even
// seen the event. Never reintroduce a read-time computation here.
//
// UPLOAD_PROOF is the one exception: it stores the user's proof URL instead.
enum EventActionType {
  TEAM_ADD // legacy alias for REFERRAL_SIGNUP
  TASK_COMPLETE
  QUIZ_COMPLETE
  LOTTERY_BUY
  UPLOAD_PROOF
  SOCIAL_ACTION // legacy catch-all: satisfied by any FEED_* action
  FEED_LIKE
  FEED_COMMENT
  FEED_SHARE
  FEED_POST
  FEED_VOTE
  REFERRAL_SIGNUP
}

model Event {
  id                  String              @id @default(cuid())
  title               String
  description         String?
  actionType          EventActionType
  threshold           Int                 @default(1)
  rewardPoints        Int                 @default(0)
  rewardXp            Int                 @default(0)
  // Optional reward tiers: [{ threshold, rewardPoints, rewardXp }] ascending.
  // When set, the event is multi-tier and each tier is claimed independently.
  tiers               Json?
  requiredAccessLevel Int                 @default(0)
  startAt             DateTime
  endAt               DateTime
  isActive            Boolean             @default(true)
  // AudienceCriteria (src/lib/audience.ts) — country/gender/age/package/etc.
  audience            Json?
  // Max actions credited per user per local day. 0 = unlimited.
  dailyCap            Int                 @default(0)
  notifyOnStart       Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  progress            UserEventProgress[]
  actionLogs          EventActionLog[]

  @@index([isActive, startAt, endAt])
}

model UserEventProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Authoritative counter. Only event-progress.ts increments it; claiming must
  // never write it — a claim-time snapshot would clobber the real count.
  progress     Int       @default(0)
  proofUrl     String?
  claimedAt    DateTime?
  // Which tier thresholds this user has already claimed (multi-tier events).
  claimedTiers Int[]     @default([])
  // First credited action — this user's personal start line for the event.
  joinedAt     DateTime?
  lastActionAt DateTime?
  // User-local day key + count, for Event.dailyCap.
  dayKey       String?
  dayCount     Int       @default(0)
  // Dedups the one-time "reward ready" notification.
  notifiedComplete Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, eventId])
  @@index([eventId])
}

// One row per action that actually counted toward an event.
//
// The unique constraint is the single enforcement point for every anti-abuse
// rule: liking the same post twice, unlike-then-relike, a replayed referral
// verification, a retried lottery purchase — all collapse to one row, so the
// counter above can only move once per real action.
model EventActionLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // The emitted key, e.g. "feed_like" — narrower than the event's actionType,
  // which may be a legacy alias that accepts several keys.
  actionKey String
  // What makes this action unique, e.g. "like:<postId>", "referral:<userId>".
  dedupKey  String
  units     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([eventId, userId, dedupKey])
  @@index([eventId, userId])
  @@index([createdAt])

  // Foreign key with no covering index — Postgres does not create one,
  // so both the join and the parent-delete referential check were scans.
  @@index([userId])
}

// Per-viewer impression counter for boosted posts (feed boost frequency cap).
// Once `count` reaches the admin cap (feed.boost_max_per_user), the boosted
// post stops recirculating to that user.
model PostBoostView {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  count       Int      @default(0)
  lastShownAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}
