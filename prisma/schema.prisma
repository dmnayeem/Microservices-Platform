  dateKey   String
  createdAt DateTime @default(now())

  @@index([userId, dateKey, action])
  @@index([postId])
  // Lifetime distinct-post count per actor+action (social-earning batch reward).
  @@index([userId, action, postId])
  @@index([createdAt])
  // Event progress counts a user's actions over a date range.
  @@index([userId, createdAt])
}

// Per-user daily AI-generation counter (rate limit for /api/ai/generate).
// One row per user per UTC day; `count` increments on each generate call.
model AiUsageDaily {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, dateKey])
}

// Progress toward a social-earning ratio reward ("every 100 likes → 10 pts").
//
// Replaces a live `COUNT(DISTINCT postId)` over SocialActionLog, which was wrong
// in two ways: that table is keyed by the ACTOR (so it can't answer "likes MY
// posts received"), and log retention prunes it at 120 days — so the count went
// BACKWARDS and long-lived users silently stopped earning forever.
//
// `count` is the REMAINDER toward the next milestone, not a running total. That
// is what makes changing `perCount` safe: there is no batch index to misalign,
// so lowering 100→50 for someone sitting at 60 pays them once (they earned it)
// instead of replaying an already-paid index.
model SocialRatioTally {
  id     String @id @default(cuid())
  userId String // the user who gets PAID — author for recipient, engager for actor
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String // "recipient" | "actor"
  action String // SocialAction, e.g. "LIKE_RECEIVED"
  window String // "daily" | "lifetime"
  // The PAID user's local day for `daily`; the literal "*" for `lifetime`.
  dateKey   String
  count     Int      @default(0) // progress toward the next milestone
  paidCount Int      @default(0) // milestones paid — monotonic, never reset
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, role, action, window, dateKey])
  // Retention prunes stale DAILY rows only — see lib/log-retention.ts.
  @@index([window, updatedAt])
}

