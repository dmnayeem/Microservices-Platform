model Post {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  content     String    @db.Text
  images      String[]
  // Facebook-style colored background for text-only posts. Stores a palette id
  // from src/lib/post-backgrounds.ts (e.g. "ocean"); null = plain post.
  backgroundStyle String?
  isPublic    Boolean   @default(true)
  isPinned    Boolean   @default(false)
  // Soft-moderation: hidden by an agency moderator (kept for audit, excluded from feed)
  isHidden    Boolean   @default(false)
  // Admin-set OFFICIAL announcement. Pinned to the very top of the feed
  // and shown with an OFFICIAL badge. Created via /api/admin/feed/announce.
  isAnnouncement   Boolean   @default(false)
  // Admin-set PROMOTED post. Appears with a PROMOTED badge and is
  // interleaved through the feed. Auto-expires when promotedUntil < now().
  isPromoted       Boolean   @default(false)
  promotedUntil    DateTime?
  // Optional sponsor name shown next to the PROMOTED badge (e.g. "NordVPN").
  promotedNote     String?   @db.VarChar(120)
  likesCount  Int       @default(0)
  commentsCount Int     @default(0)
  sharesCount Int       @default(0)
  viewsCount  Int       @default(0)
  socialEarnings Int    @default(0)
  pollOptions Json?     // [{ id, label, voteCount }]
  pollEndsAt  DateTime?
  // OpenGraph preview of the first URL in `content`, fetched best-effort at
  // create time: { url, title, description, image, siteName }. Null = no card.
  linkPreview Json?
  donationGoal      Int?
  donationCollected Int       @default(0)
  groupId           String?
  group             Group?    @relation(fields: [groupId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Freshness signal for the smart feed: bumped when a new comment arrives so
  // the post resurfaces. Defaults to createdAt for new/legacy rows.
  lastActivityAt DateTime @default(now())
  comments    Comment[]
  likes       Like[]
  votes       Vote[]
  donations   Donation[]
  views       PostView[]
  shares      PostShare[]
  mentions    Mention[]
  adPromotions Ad[]     @relation("PostAds")
  @@index([userId])
  @@index([createdAt])
  @@index([groupId])
  @@index([isAnnouncement])
  @@index([isPromoted, promotedUntil])
  @@index([isPublic, createdAt])
  @@index([isPublic, isHidden, isPinned, createdAt])
  @@index([isPublic, isHidden, lastActivityAt])
}

model Follow {
  id          String   @id @default(cuid())
