// Verified platform link — one row per (user × platform). Unlike SocialAccount
// (self-reported handle/stats), this stores a REAL platform user-id captured via
// Telegram Login Widget / Discord OAuth, so a bot can confirm channel/guild
// membership for auto-verified JOIN tasks (anti-fraud Phase C).
model LinkedPlatformAccount {
