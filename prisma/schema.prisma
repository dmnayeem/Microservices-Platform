model TaskSubmission {
  id            String           @id @default(cuid())
  taskId        String
  task          Task             @relation(fields: [taskId], references: [id])
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  status        SubmissionStatus @default(PENDING)
  proof         String?          @db.Text
  proofImages   String[]
  answers       Json?
  score         Int?
  reviewedBy    String?
  reviewedAt    DateTime?
  rejectionReason String?
  pointsEarned  Int?
  xpEarned      Int?
  // Server-authoritative watch tracking (VIDEO + SOCIAL watch actions). The
  // heartbeat route accrues real, playing+focused seconds here so the submit
  // gate never has to trust a client-claimed watch count.
  watchedSeconds Int             @default(0)
  lastBeatAt     DateTime?
  // Set the moment the user actually SUBMITS proof (vs. merely /start-ing the
  // task). Distinguishes "in progress" (PENDING, submittedAt null) from
  // "submitted / pending review" (PENDING, submittedAt set) for the task list.
  submittedAt    DateTime?
  // Type-specific proof bag — used by SOCIAL ({ socialUsername, socialGeneratedContent }),
  // forward-flexible for future task types.
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  // Article key-pool relations (only populated for ARTICLE tasks with useKeyPool=true)
  articleKey    ArticleTaskKey?
  pageProgress  ArticleTaskPageProgress[]
  @@unique([taskId, userId, createdAt])
  @@index([userId])
  @@index([taskId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userId, status, createdAt])
}

// Anti-fraud fingerprint of a SOCIAL task's submitted proof values (feature #10).
// One row per proof value (post/profile URL, screenshot URL, username) per
// submission. On submit we look up matching (taskId, kind, value) rows from a
// DIFFERENT user to flag likely duplicate/recycled proof for admin review.
model SocialProofFingerprint {
  id           String   @id @default(cuid())
  taskId       String
  userId       String
  submissionId String
  kind         String   // "URL" | "SCREENSHOT" | "USERNAME"
  // SHA-256 of the normalized proof value — fixed length so the equality index
  // is safe for arbitrarily long URLs (a raw-text btree index can overflow).
  valueHash    String
  createdAt    DateTime @default(now())

  @@index([taskId, kind, valueHash])
  @@index([submissionId])
}

// Pool of one-time-use unique keys for an ARTICLE task. Keys are claimed
// atomically by the cross-domain embed flow on the final article page; once
// claimed, the row is locked to the user + submission.
model ArticleTaskKey {
  id              String          @id @default(cuid())
  taskId          String
  task            Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  keyValue        String
  // Unclaimed when null. Set atomically when the user clicks "Generate Key"
  // on the final article page.
  claimedByUserId String?
  claimedByUser   User?           @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)
  claimedAt       DateTime?
  // Set when the user actually submits the key back to /api/tasks/:id/submit.
  submissionId    String?         @unique
  submission      TaskSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())

  @@unique([taskId, keyValue])
  @@index([taskId, claimedByUserId])
  @@index([claimedByUserId])
}

// Per-page popup completion progress. The embed script POSTs each completed
// popup; we increment the row. Page is "done" when popupsCompleted >=
// articleConfig.pages[pageIndex].popupCount.
model ArticleTaskPageProgress {
  id              String         @id @default(cuid())
  submissionId    String
  submission      TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  pageIndex       Int
  popupsCompleted Int            @default(0)
  pageCompleted   Boolean        @default(false)
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([submissionId, pageIndex])
  @@index([submissionId])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  points      Int               @default(0)
  amount      Decimal           @default(0) @db.Decimal(18, 6)
  description String?
  reference   String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  // Idempotency backstop: a deterministic `reference` for a once-only money event
  // is unique per user, so a retry / concurrent-double / replay that reuses the
  // same reference hits P2002 and is caught (see src/lib/idempotency.ts). Scoped
  // to `userId` (not a global @unique on `reference`) because double-entry writes
  // two rows — buyer debit + seller credit — that deliberately share one
  // reference but have DIFFERENT userId. NULL references stay unconstrained
  // (Postgres treats NULLs as distinct), so legitimately-repeatable events that
  // use per-occurrence-distinct references are unaffected.
  @@unique([userId, reference])
  // Kept for reference-only lookups (findFirst by reference) that can't use the
  // composite (userId, reference) index.
  @@index([reference])
}

// Client-driven request idempotency. A money POST may send an `Idempotency-Key`
// header (a per-action UUID); the server reserves a row here, runs the handler
// once, stores the response, and replays the SAME response for any retry that
// reuses the key. Complements the P5 ledger `@@unique([userId, reference])`
// (which dedupes the money ROW) by deduping the whole HTTP request/response.
model IdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  key            String
  method         String
  endpoint       String
  // 0 = reserved/in-flight; non-zero = completed HTTP status of the stored response.
  responseStatus Int      @default(0)
  response       Json     @default("{}")
  createdAt      DateTime @default(now())
  @@unique([userId, key])
  @@index([createdAt])
}

