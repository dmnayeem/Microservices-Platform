  processedBy     User?               @relation("CourseRefundAdmin", fields: [processedById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  processedAt     DateTime?
  @@index([status])
  @@index([userId])
}

model CourseListingView {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String?
