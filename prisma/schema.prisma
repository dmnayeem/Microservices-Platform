  ITEM_NOT_RECEIVED
  ITEM_NOT_AS_DESCRIBED
  PAYMENT_ISSUE
  SELLER_UNRESPONSIVE
  BUYER_UNRESPONSIVE
  QUALITY_ISSUE
  OTHER
}

