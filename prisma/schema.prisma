model Task {
  id                  String           @id @default(cuid())
  title               String
  description         String           @db.Text
  instructions        String?          @db.Text
  instructionVideoUrl String?
  type                TaskType
  status              TaskStatus       @default(ACTIVE)
  difficulty          TaskDifficulty   @default(MEDIUM)
  pointsReward        Int
  cashReward          Decimal          @default(0) @db.Decimal(18, 6)
  xpReward            Int              @default(0)
  isBoardOnly         Boolean          @default(false)
  boardId             String?
  board               TaskBoard?       @relation(fields: [boardId], references: [id], onDelete: SetNull)
  dailyLimit          Int?
  totalLimit          Int?
  completedCount      Int              @default(0)
  minLevel            Int              @default(1)
  requiredAccessLevel Int              @default(0)
  // Super-admin hard hide — excludes the task from all user-facing lists
  // regardless of level/access/type gating. Admin-only visibility control.
  hidden              Boolean          @default(false)
  // Sequential-unlock ordering — lower shows/unlocks first (feature #7).
  order               Int              @default(0)
  countries           String[]         @default([])
  // Audience targeting (empty array = no constraint on that dimension). Matched
  // STRICTLY against the viewer's profile — a user missing a targeted attribute
  // is excluded. See src/lib/task-targeting.ts.
  genders             String[]         @default([])
  regions             String[]         @default([])
  divisions           String[]         @default([])
  districts           String[]         @default([])
  subDistricts        String[]         @default([])
  postalCodes         String[]         @default([])
  minAge              Int?
  maxAge              Int?
  contentUrl          String?
  thumbnailUrl        String?
  duration            Int?
  questions           Json?
  socialPlatform      String?
  socialAction        String?
  socialUrl           String?
  socialConfig        Json? // Platform×action specific config (see lib/social-tasks.ts SocialConfig)
  articleConfig       Json? // Article task config (see lib/article-tasks.ts ArticleConfig)
  videoConfig         Json? // Video task config (see lib/video-tasks.ts VideoConfig)
  surveyConfig        Json? // Survey task config (see lib/survey-tasks.ts SurveyConfig)
  customConfig        Json? // Custom task config (see lib/custom-tasks.ts CustomConfig)
  appInstallConfig    Json? // App-install task config (see lib/app-install-tasks.ts AppInstallConfig)
  proxyInstructions   String?          @db.Text
  startsAt            DateTime?
  expiresAt           DateTime?
  cooldownMinutes     Int              @default(0)
  autoApprove         Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdById         String?
  // User-created tasks fund their reward pool from the creator's wallet.
  fundedByUserId      String?
  budgetPoints        Int              @default(0)
  remainingBudget     Int              @default(0)
  rejectionReason     String?          @db.Text
  submissions         TaskSubmission[]
  categories          TaskCategory[]
  // Article-task key-pool relations (only used when articleConfig.useKeyPool=true)
  articleKeys         ArticleTaskKey[]

  @@index([status])
  @@index([type])
  @@index([requiredAccessLevel])
  @@index([status, createdAt])
  @@index([status, order])
  @@index([createdById])
  @@index([fundedByUserId])
  // The user-facing task list: status + hidden equality, then the [order,
  // createdAt] sort. [status, order] missed `hidden` and the tiebreak.
  @@index([status, hidden, order, createdAt])
  // Unindexed FK: deleting a TaskBoard SET NULLs every task, which without this
  // is a sequential scan of the Task table.
  @@index([boardId])
}

model TaskCategory {
  id          String   @id @default(cuid())
