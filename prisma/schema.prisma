// EarnGPT Database Schema
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // CommonJS output avoids the ESM `import.meta.url` + top-level side-effect
  // pattern in the generated client that crashed the Turbopack DEV server
  // ("Expected export to be in eval context"), letting us keep fast Turbopack dev.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  TUTOR
  SUPER_ADMIN
  // Generic admin below super-admin; super-admin grants it powers. Also the
  // baseline enum role carried by users assigned a CustomRole.
  ADMIN
  FINANCE_ADMIN
  CONTENT_ADMIN
  SUPPORT_ADMIN
  MARKETING_ADMIN
  MODERATOR
  // Advertiser/agency console (user-side, not an admin-panel role).
  AGENCY
  // Ad Manager admin — scoped to the Ads Manager surface.
  AD_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum TaskType {
  VIDEO
  ARTICLE
  QUIZ
  SURVEY
  SOCIAL
  PROXY
  OFFERWALL
  CUSTOM
  APPINSTALL
}

enum TaskStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
  PENDING_REVIEW
  REJECTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
  REVISION_REQUESTED
}

enum TransactionType {
  EARNING
  WITHDRAWAL
  BONUS
  REFERRAL
  PURCHASE
  REFUND
  PENALTY
  GIFT
  LOTTERY_WIN
  CHECKIN
  COURSE_PURCHASE
  COURSE_TUTOR_EARNING
  COURSE_REFUND
  DEPOSIT
  AFFILIATE_COMMISSION
  ADMIN_FEE
  AD_CREDIT_PURCHASE
  POINTS_CONVERSION
}

// What earning generated a referral commission. Currently only tasks pay
// referral commissions; enumerated so new sources are added deliberately.
enum ReferralSourceType {
  TASK
  PURCHASE
  SUBSCRIPTION
  COURSE
  SIGNUP
  MONTHLY_BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BINANCE
  PAYPAL
}

// PackageTier enum removed in 2026-05 migration — use Package model + accessLevel instead.

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BannerLocation {
  HOME
  EARN_HUB
  MARKETPLACE
  DASHBOARD
  ALL
}

/// Game catalog taxonomy. Replaces the free-text `Game.category`, where
/// "Puzzle" / "puzzle" / "Puzzles" were three different categories and the user
/// catalog had no filter at all. Mirrors CourseCategory.
model GameCategory {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  iconKey  String?
  color    String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  games     Game[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

/// HTML5 game catalog entry — admin supplies art + an embed URL; users play it
/// in a full-screen iframe with interstitial ads on open/resume/quit.
///
/// Earning is OFF by default (`rewardEnabled`), so every pre-existing game keeps
/// the original "no reward" contract exactly.
model Game {
  id          String  @id @default(cuid())
  title       String
  /// legacy free-text category — kept as a fallback for rows not yet migrated,
  /// and as the source for the one-off backfill. Superseded by `categoryId`.
  category    String?
  categoryId  String?
  categoryRel GameCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description String? @db.Text
  /// Square tile art.
  iconUrl     String
  /// Wide cover art for the featured row. Optional; falls back to `iconUrl`.
  coverUrl    String?
  embedUrl    String
  isFeatured  Boolean @default(false)
  /// ANY | PORTRAIT | LANDSCAPE — a hint for the player shell.
  orientation String  @default("ANY")
  /// Last server-side framing probe: {ok, xfo, csp, checkedAt}. Cross-origin JS
  /// cannot detect `X-Frame-Options: DENY`, so without this a refusing URL just
  /// shows users a black screen and nobody finds out.
  embedProbe  Json?
  order       Int     @default(0)
  isActive    Boolean @default(true)
  /// Historical value counts client mounts (the old, farmable endpoint). From
  /// the session protocol onward it counts authenticated, rate-limited sessions,
  /// so the number legitimately slows down — the UI labels it "legacy plays".
  playsCount  Int     @default(0)

  // ── Per-game ad control ──────────────────────────────────────────────────
  adsEnabled        Boolean @default(true)
  adOnOpen          Boolean @default(true)
  adOnResume        Boolean @default(true)
  adOnQuit          Boolean @default(true)
  /// Mid-session interstitial cadence. 0 = none.
  adIntervalSeconds Int     @default(0)
  /// Minimum gap between interstitials (was a hardcoded AD_THROTTLE_MS).
  adThrottleSeconds Int     @default(60)
  /// Validated server-side against AD_PLACEMENTS and restricted to *_INTERSTITIAL:
  /// pointing a game at IN_FEED would serve advertiser inventory full-screen in
  /// a slot it was never bought for.
  adPlacement       String  @default("GAME_INTERSTITIAL")

  // ── Earning rules (all clamped by the global games.* SystemSettings) ─────
  rewardEnabled        Boolean @default(false)
  rewardPointsPerTick  Int     @default(0)
  rewardTickSeconds    Int     @default(60)
  /// 0 = only the daily caps apply.
  rewardMaxPerSession  Int     @default(0)
  rewardDailyCapPoints Int     @default(0)
  /// Tie payout to the ads that fund it. The count is server-authoritative:
  /// the game asks the SERVER for its interstitial (see /api/games/[id]/ad).
  rewardRequiresAd     Boolean @default(false)

  // ── Score rewards — deliberately inert without a signed callback ─────────
  scoreRewardEnabled  Boolean @default(false)
  /// A score posted from an arbitrary third-party embed is unverifiable. Only a
  /// first-party game with an HMAC-signed callback may be trusted.
  scoreTrusted        Boolean @default(false)
  scorePointsPer1000  Int     @default(0)
  scoreDailyCapPoints Int     @default(0)

  // ── Denormalised analytics, folded in when a session ends ────────────────
  uniquePlayersCount Int @default(0)
  totalPlaySeconds   Int @default(0)
  adsShownCount      Int @default(0)
  pointsAwardedTotal Int @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions GameSession[]

  @@index([isActive])
  @@index([order])
  @@index([isFeatured, order])
  @@index([categoryId, isActive, order])
}

/// One play session. Time is measured by the SERVER from heartbeat gaps — the
/// client never sends a duration, because there would be nothing stopping it
/// sending a large one.
///
/// `onDelete: Restrict` on purpose: these rows are the record of what was paid.
/// Deleting a game must not erase its payout history, so the admin route
/// deactivates a game that has sessions instead.
model GameSession {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Restrict)
  userId String

  startedAt  DateTime  @default(now())
  lastBeatAt DateTime?
  endedAt    DateTime?

  /// Server-measured foreground seconds.
  playedSeconds   Int @default(0)
  /// Seconds already converted into points. The gap between this and
  /// `playedSeconds` is what the next tick pays, which makes crediting
  /// exactly-once even if a heartbeat is replayed.
  creditedSeconds Int @default(0)
  pointsAwarded   Int @default(0)
  /// Incremented by the server when it serves this session an interstitial.
  adsShown        Int @default(0)
  score           Int?

  createdAt DateTime @default(now())

  @@index([gameId, startedAt])
  @@index([userId, startedAt])
  /// Serves the "one open session per user" lookup.
  @@index([userId, endedAt])
}

/// Money log for game earnings. Deliberately FK-free, mirroring BrowseEarnLog
/// and AdCreditLedger: deleting a game must never delete the record of what it
/// paid out.
model GameEarnLog {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  sessionId String?
  points    Int      @default(0)
  /// TIME | SCORE
  kind      String   @default("TIME")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, gameId, createdAt])
  @@index([gameId, createdAt])
}

model Banner {
  id          String         @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String?
  videoUrl    String? // optional background video (takes precedence over imageUrl)
  iconEmoji   String?
  bgGradient  String? // e.g. "from-blue-600 to-purple-600"
  linkUrl     String?
  location    BannerLocation @default(HOME)
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([location])
  @@index([isActive])
  @@index([order])
  @@index([isActive, location])
}

/// Admin-built marketing "offer" pages, viewable by anyone at /offer/[slug].
model Offer {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String?  @db.Text
  thumbnailUrl String?
  bgGradient   String?
  blocks       Json     @default("[]")
  status       String   @default("DRAFT") // DRAFT | PUBLISHED
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model Campaign {
  id                 String   @id @default(cuid())
  title              String
  description        String?  @db.Text
  type               String // XP_MULTIPLIER | BONUS_POINTS | FREE_TICKETS | DISCOUNT | REFERRAL_BOOST | SEASONAL
  value              Float    @default(1)
  startDate          DateTime
  endDate            DateTime
  targetType         String   @default("ALL") // ALL | TIER | NEW_USERS | COUNTRY
  targetValue        String?
  budget             Decimal? @db.Decimal(18, 6)
  bannerImage        String?
  termsAndConditions String?  @db.Text
  status             String   @default("SCHEDULED") // SCHEDULED | ACTIVE | PAUSED | ENDED
  participantCount   Int      @default(0)
  rewardsDistributed Decimal  @default(0) @db.Decimal(18, 6)
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([startDate, endDate])
}

/// Long-running "big prize" missions — the middle of the three goal systems.
///
///  - **DailyMissionTemplate** = do today's tasks properly; resets at the
///    user's local midnight and feeds the referral day-claim.
///  - **Mission** (this) = a large reward that takes real effort, with tiers and
///    an unlock chain, so finishing one pulls the user toward the next.
///  - **Event** = time-boxed marketing pushes.
///
/// All three now share ONE progress engine (src/lib/goal-progress.ts) and the
/// same `EventActionType` vocabulary. Mission used to have its own five-value
/// `type` string that nothing on the user side ever read — the whole model was
/// admin CRUD with no reader, no progress table and no claim route.
model Mission {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  iconEmoji   String?

  /// Legacy free-text kind (TASK_COMPLETION | LOGIN_STREAK | REFERRAL | SPEND |
  /// EARN). Superseded by `actionType`; kept only so the pre-existing rows are
  /// still readable. Nothing reads it.
  type String @default("TASK_COMPLETION")

  /// What counts. Shared with Event so one ACCEPTS map drives both.
  actionType EventActionType @default(TASK_COMPLETE)
  /// The goal. (Was `targetValue`, which the admin form already edits.)
  targetValue Int
  /// Optional ascending tiers [{threshold, rewardPoints, rewardXp}], claimed
  /// independently — this is what makes a mission worth rushing.
  tiers Json?

  pointsReward Int     @default(0)
  cashReward   Decimal @default(0) @db.Decimal(18, 6)
  xpReward     Int     @default(0)

  /// Max actions credited per user per LOCAL day. 0 = unlimited.
  dailyCap Int @default(0)

  duration    String   @default("DAILY") /// legacy, unused
  autoRefresh Boolean  @default(true) /// legacy, unused
  startAt     DateTime?
  endAt       DateTime?
  order       Int      @default(0)
  /// Prerequisite mission — must be claimed before this one unlocks.
  unlockMissionId String?
  unlockMission   Mission?  @relation("MissionUnlockChain", fields: [unlockMissionId], references: [id], onDelete: SetNull)
  unlocks         Mission[] @relation("MissionUnlockChain")

  requiredLevel       Int @default(1)
  requiredAccessLevel Int @default(0)
  // Audience targeting — same nine columns and STRICT semantics as Task.
  countries    String[] @default([])
  genders      String[] @default([])
  regions      String[] @default([])
  divisions    String[] @default([])
  districts    String[] @default([])
  subDistricts String[] @default([])
  postalCodes  String[] @default([])
  minAge       Int?
  maxAge       Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress   UserMissionProgress[]
  actionLogs MissionActionLog[]

  @@index([isActive])
  @@index([duration])
  @@index([isActive, order])
  @@index([unlockMissionId])
}

/// Per-user mission counter. Mirrors UserEventProgress exactly — same rules,
/// same guarantees. Only goal-progress.ts increments `progress`; claiming must
/// never write it, or a claim-time snapshot clobbers the real count.
model UserMissionProgress {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  progress     Int       @default(0)
  claimedAt    DateTime?
  claimedTiers Int[]     @default([])
  joinedAt     DateTime?
  lastActionAt DateTime?
  dayKey       String?
  dayCount     Int       @default(0)
  notifiedComplete Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, missionId])
  @@index([missionId])
}

/// One row per action that actually counted toward a mission.
///
/// The `@@unique` is the whole anti-farm guarantee — NOT application logic.
/// Without it, like → unlike → like would count three times against a mission
/// whose prize is deliberately large.
model MissionActionLog {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId    String
  actionKey String
  /// Stable per-action identity, e.g. "like:<postId>".
  dedupKey  String
  units     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([missionId, userId, dedupKey])
  @@index([userId, createdAt])
}

// Daily Task Mission — admin-defined per-package mission template that bundles
// several "complete N tasks of type X" buckets. Users see today's mission for
// their tier, work through every bucket, then claim the final reward.
model DailyMissionTemplate {
  id                     String   @id @default(cuid())
  name                   String
  description            String?  @db.Text
  requiredAccessLevel    Int      @default(0)
  requiredLevel          Int      @default(1)
  completionXpReward     Int      @default(0)
  completionPointsReward Int      @default(0)
  /// Paid alongside points on completion. 0 = points/XP only.
  completionCashReward   Decimal  @default(0) @db.Decimal(18, 6)
  /// Streak bonus: every `streakBonusEvery` consecutive days, add
  /// `streakBonusPoints`. 0 on either disables it. `DailyMissionClaim.streak`
  /// was already being computed and stored but never rewarded anything.
  streakBonusEvery       Int      @default(0)
  streakBonusPoints      Int      @default(0)
  isActive               Boolean  @default(true)
  autoRefresh            Boolean  @default(true)
  linkReferralBonus      Boolean  @default(false)
  order                  Int      @default(0)
  /// Optional schedule. null = always running.
  startAt                DateTime?
  endAt                  DateTime?

  // Audience targeting — same nine columns and STRICT semantics as Task.
  // Without these, a "Bangladesh only" daily mission was impossible: the
  // template was picked purely by tier and level.
  countries    String[] @default([])
  genders      String[] @default([])
  regions      String[] @default([])
  divisions    String[] @default([])
  districts    String[] @default([])
  subDistricts String[] @default([])
  postalCodes  String[] @default([])
  minAge       Int?
  maxAge       Int?

  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  items  DailyMissionItem[]
  claims DailyMissionClaim[]

  @@index([requiredAccessLevel])
  @@index([isActive])
}

model DailyMissionItem {
  id                String               @id @default(cuid())
  missionId         String
  mission           DailyMissionTemplate @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// One of MISSION_TASK_TYPES in src/lib/mission-labels.ts — that list is the
  /// single definition. This comment used to enumerate the values here too and
  /// had already fallen behind by five (the SOCIAL_* ones).
  taskType          String
  description       String?              @db.Text
  targetCount       Int                  @default(1)
  xpPerComplete     Int                  @default(0)
  pointsPerComplete Int                  @default(0)
  duration          Int? // minutes (display-only)
  requiredLevel     Int?
  order             Int                  @default(0)

  @@index([missionId])
}

model DailyMissionClaim {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   DailyMissionTemplate @relation(fields: [missionId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD (UTC)
  streak    Int                  @default(1)
  claimedAt DateTime             @default(now())

  @@unique([userId, missionId, date])
  @@index([userId, date])
  @@index([missionId])
}

model DailyReferralClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD (UTC)
  amount    Decimal  @db.Decimal(18, 6)
  points    Int
  claimedAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model AdCampaign {
  id           String    @id @default(cuid())
  advertiserId String?
  advertiser   User?     @relation("UserAdCampaigns", fields: [advertiserId], references: [id], onDelete: SetNull)
  title        String
  description  String?   @db.Text
  // Remaining (undrawn) budget — each billed click decrements it.
  budget       Decimal   @default(0) @db.Decimal(18, 6)
  // Lifetime billed spend. Authoritative: reporting must NOT derive spend as
  // clicks × current CPC, which rewrites history whenever the CPC changes.
  spentTotal   Decimal   @default(0) @db.Decimal(18, 6)
  // House (platform-owned) inventory — exempt from the budget gate and the only
  // ads an ad-free package may be shown.
  isHouse      Boolean   @default(false)
  status       String    @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  // Optional flight window — ads only serve while now is within [startAt, endAt].
  startAt      DateTime?
  endAt        DateTime?
  ads          Ad[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([advertiserId])
  @@index([status])
  @@index([status, startAt, endAt])
}

model AdPlacement {
  id                  String   @id @default(cuid())
  name                String   @unique
  platform            String   @default("ALL")
  isActive            Boolean  @default(true)
  // Per-space ad-rotation interval (seconds). Null = use the global
  // `ads.rotation_seconds` setting. Clamped 5–60 when set.
  rotationSeconds     Int?
  // Per-space interstitial ad duration (seconds) — how long the full-screen ad
  // shows before it can be closed. Null = default 5s. Clamped 3–60 when set.
  interstitialSeconds Int?
  ads                 Ad[]
  createdAt           DateTime @default(now())
}

model AdNetwork {
  id              String   @id @default(cuid())
  name            String
  providerKey     String   @unique
  initScript      String?  @db.Text
  isEnabledWeb    Boolean  @default(true)
  isEnabledMobile Boolean  @default(true)
  globalWeight    Int      @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Ad {
  id                String        @id @default(cuid())
  campaignId        String
  campaign          AdCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placementId       String
  placement         AdPlacement   @relation(fields: [placementId], references: [id])
  type              String        @default("LOCAL") // LOCAL | HTML | ADSENSE | GAM
  format            String        @default("BANNER") // BANNER | NATIVE (feed post-like)
  contentUrl        String? // image / GIF creative URL
  videoUrl          String? // MP4/WebM video creative URL
  targetUrl         String?
  htmlContent       String?       @db.Text
  // Third-party ad-network config (type ADSENSE | GAM). The self-contained
  // creative HTML is composed server-side in src/lib/ad-network.ts.
  adSlot            String? // AdSense ad-slot id (data-ad-slot)
  adUnitPath        String? // Google Ad Manager ad-unit path (/network/unit)
  adClient          String? // optional per-ad AdSense client override (ca-pub-…)
  // Optional third-party tracking pixels (any type).
  impressionPixel   String? // 1×1 beacon fired on view
  clickTracker      String? // pinged on click (local creatives)
  // Creative size — preset key (see src/lib/ad-sizes.ts); width/height used for "custom"
  size              String?       @default("responsive")
  width             Int?
  height            Int?
  weight            Int           @default(10)
  // ACTIVE | PAUSED | INACTIVE | PENDING (awaiting admin review) | CHANGES_REQUESTED | REJECTED
  // Only src/lib/ad-review.ts may write this column — it is the review gate.
  status            String        @default("ACTIVE")
  // Review workflow (advertiser-submitted ads land as PENDING until an admin acts)
  submittedById     String?
  submittedAt       DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  // Set the first time an admin approves and NEVER cleared — this is the
  // "a reviewed creative exists" bit that lets an advertiser resume a paused ad
  // without being able to activate one that was never reviewed.
  approvedAt        DateTime?
  rejectionReason   String?       @db.Text
  rejectionCodes    String[]      @default([])
  reviewNote        String?       @db.Text // internal reviewer note (never shown to the advertiser)
  // One id per submission — a multi-placement submit creates N Ad rows that a
  // reviewer should see (and decide on) together.
  creativeGroupId   String?
  // ads.manage-only escape hatch: lets a trusted network creative keep
  // `allow-same-origin` while advertiser HTML never can. See sandboxed-ad-frame.
  allowSameOrigin   Boolean       @default(false)
  reviews           AdReview[]
  engagements       AdEngagement[]
  impressions       Int           @default(0)
  clicks            Int           @default(0)
  // Native (post-like) creative fields — used when format = NATIVE
  headline          String?       @db.Text // post-like ad copy
  brandName         String? // shown as author name
  brandLogo         String? // author avatar URL
  ctaLabel          String? // CTA button label (e.g. "Learn More")
  // Promote-a-real-post: when set, the native ad renders this post + its author
  promotedPostId    String?
  promotedPost      Post?         @relation("PostAds", fields: [promotedPostId], references: [id], onDelete: SetNull)
  // Simple targeting: { countries?, genders?, minLevel?, packages? } (null = everyone)
  targeting         Json?
  // Viewer-reward (watch-and-earn)
  rewardPoints      Int           @default(0)
  rewardCooldownSec Int           @default(3600)
  watchSeconds      Int           @default(15)
  views             AdView[]
  dailyStats        AdDailyStat[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([campaignId])
  @@index([placementId])
  @@index([status])
  @@index([promotedPostId])
  @@index([placementId, status])
  @@index([status, createdAt])
  @@index([creativeGroupId])
}

// Append-only decision trail for the ad review gate: who submitted, who decided,
// why, and what the creative looked like at the time. Powers the admin review
// timeline, the advertiser's "why was I rejected" panel, and reversibility.
model AdReview {
  id           String   @id @default(cuid())
  adId         String
  ad           Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  // Raw id, no FK — actors can be deleted (AdCampaign.advertiserId uses SetNull
  // for the same reason). Identities are hydrated with a batched findMany.
  actorId      String?
  // SUBMITTED | RESUBMITTED | EDIT_SUBMITTED | APPROVED | APPROVED_WITH_EDITS
  // | REJECTED | CHANGES_REQUESTED | REOPENED | AUTO_PAUSED
  action       String
  reasonCodes  String[] @default([])
  message      String?  @db.Text // advertiser-visible
  internalNote String?  @db.Text // admin-only
  snapshot     Json? // creative at decision time
  createdAt    DateTime @default(now())

  @@index([adId, createdAt])
  @@index([actorId])
}

// Durable view/click dedup. Replaces the per-instance in-memory cooldown map,
// which serverless made useless (a competitor could drain a budget by fanning
// requests across instances). The unique index IS the cooldown.
model AdEngagement {
  id        String   @id @default(cuid())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  // userId, or `ip:<sha256>` when anonymous. NOT NULL on purpose: Postgres
  // treats NULLs as distinct, so a nullable column would never dedup anon traffic.
  subject   String
  userId    String?
  kind      String // VIEW | CLICK
  bucket    BigInt // floor(epochMs / windowMs)
  billed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([adId, kind, subject, bucket])
  @@index([adId, createdAt])
  @@index([createdAt])
}

// Per-day rollup of ad impressions/clicks/spend for time-series analytics.
model AdDailyStat {
  id          String   @id @default(cuid())
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spendUsd    Decimal  @default(0) @db.Decimal(18, 6)

  @@unique([adId, date])
  @@index([adId, date])
}

model AdView {
  id             String   @id @default(cuid())
  userId         String
  adId           String
  ad             Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  rewardedPoints Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId, adId])
  @@index([userId, createdAt])
  @@index([adId])
  @@index([userId, adId, createdAt])
  @@index([createdAt])
}

// Passive "Browse & Earn" credits — one row per interval a user is rewarded for
// keeping the ad-supported browse page open (network ads earn the platform CPM).
// Enforces the per-interval cooldown + per-local-day cap; never farms.
model BrowseEarnLog {
  id        String   @id @default(cuid())
  userId    String
  points    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Advertiser ad-credit history. `delta` is the signed USD change to
// User.adCreditBalance; `kind` classifies it. Bare userId (no back-relation
// needed on both sides — mirrors other ledger patterns).
model AdCreditLedger {
  id           String   @id @default(cuid())
  userId       String
  delta        Decimal  @db.Decimal(18, 6)
  kind         String // PURCHASE | GRANT | CAMPAIGN_FUND | REFUND
  balanceAfter Decimal? @db.Decimal(18, 6)
  reference    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Deposit {
  id         String    @id @default(cuid())
  userId     String
  amount     Decimal   @db.Decimal(18, 6)
  method     String // MANUAL_BKASH | MANUAL_NAGAD | SSLCOMMERZ | ...
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  gatewayRef String?
  // Manual deposit provider txn id — unique so the same payment can't be
  // submitted/approved twice (double-credit).
  txnId      String?   @unique
  proofUrl   String?
  adminNote  String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model FraudEvent {
  id           String        @id @default(cuid())
  userId       String?
  eventType    String // MULTIPLE_ACCOUNTS, VPN_DETECTED, etc.
  severity     FraudSeverity @default(MEDIUM)
  details      Json?
  ipAddress    String?
  userAgent    String?
  status       String        @default("OPEN") // OPEN | DISMISSED | ACTED
  resolverNote String?       @db.Text
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model ProxyServer {
  id              String    @id @default(cuid())
  name            String
  host            String
  port            Int
  protocol        String    @default("HTTPS") // HTTP | HTTPS | SOCKS5
  country         String? // ISO code
  status          String    @default("ACTIVE") // ACTIVE | INACTIVE | ERROR
  loadPercent     Int       @default(0)
  maxConcurrent   Int       @default(50)
  bandwidthMbUser Int       @default(100)
  responseTimeMs  Int?
  lastHealthCheck DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([country])
}

model OfferwallCallback {
  id              String    @id @default(cuid())
  userId          String
  offerwallId     String
  offerId         String?
  offerName       String?
  transactionId   String    @unique
  payoutAmount    Decimal   @db.Decimal(18, 6)
  userPayout      Int // points
  currency        String    @default("USD")
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | FRAUD | CHARGEBACK
  internalOfferId String? // resolved OfferwallOffer.id from the subid (catalog credit)
  isReversal      Boolean   @default(false) // chargeback / reconciliation negative postback
  fraudScore      Int       @default(0)
  fraudReasons    String[]
  ipAddress       String?
  userAgent       String?   @db.Text
  countryCode     String?
  deviceType      String?
  rawPayload      Json?
  reviewedById    String?
  reviewNote      String?   @db.Text
  rejectionReason String?   @db.Text
  processedAt     DateTime?
  creditedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([offerwallId])
  @@index([userId])
  @@index([createdAt])
}

model TaskBoard {
  id            String      @id @default(cuid())
  title         String
  description   String?     @db.Text
  iconEmoji     String?
  imageUrl      String?
  // "Marketing" | "Development" | "Design" | "Sales" | "Learning" | "Other"
  category      String?
  // null = no deadline
  expiresAt     DateTime?
  pointsReward  Int         @default(0)
  xpReward      Int         @default(0)
  isActive      Boolean     @default(true)
  order         Int         @default(0)
  // Optional prerequisite board — user must claim this board first to unlock.
  unlockBoardId String?
  unlockBoard   TaskBoard?  @relation("BoardUnlockChain", fields: [unlockBoardId], references: [id], onDelete: SetNull)
  unlocks       TaskBoard[] @relation("BoardUnlockChain")

  // Eligibility. A board had NO per-user gate of any kind except the unlock
  // chain, so every active board was listed to everyone — a board whose tasks
  // were all country-targeted simply rendered with a task count of 0 and then
  // failed its claim with "Board has no active tasks".
  minLevel            Int      @default(1)
  requiredAccessLevel Int      @default(0)
  // Audience targeting — same nine columns and the same STRICT semantics as
  // Task (empty array = no constraint). See src/lib/task-targeting.ts.
  countries    String[] @default([])
  genders      String[] @default([])
  regions      String[] @default([])
  divisions    String[] @default([])
  districts    String[] @default([])
  subDistricts String[] @default([])
  postalCodes  String[] @default([])
  minAge       Int?
  maxAge       Int?

  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tasks  Task[]
  claims BoardClaim[]

  @@index([isActive])
  @@index([order])
  @@index([category])
  @@index([unlockBoardId])
  @@index([isActive, requiredAccessLevel, minLevel])
}

// Per-user record of a Task Board reward claim. One row per (user, board);
// uniqueness enforced at the DB level so re-claims are impossible regardless
// of races. Created inside the same transaction as the EARNING transaction
// so the two stay consistent.
model BoardClaim {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId       String
  board         TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  pointsEarned  Int       @default(0)
  xpEarned      Int       @default(0)
  taskCount     Int       @default(0)
  claimedAt     DateTime  @default(now())
  transactionId String?

  @@unique([userId, boardId])
  @@index([boardId, claimedAt])
  @@index([userId])
}

model SocialReport {
  id           String    @id @default(cuid())
  contentType  String // POST | COMMENT | USER | LISTING
  contentId    String
  reporterId   String
  reason       String // SPAM | HARASSMENT | FRAUD | INAPPROPRIATE | OTHER
  details      String?   @db.Text
  priority     String    @default("NORMAL") // URGENT | HIGH | NORMAL
  status       String    @default("PENDING") // PENDING | RESOLVED
  resolution   String? // DISMISSED | WARNED | SUSPENDED | BANNED | DELETED
  resolverNote String?   @db.Text
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([contentType])
  @@index([reporterId])
  @@index([createdAt])
  @@index([status, contentType])
  @@index([contentType, contentId])
}

model Quiz {
  id                  String         @id @default(cuid())
  title               String
  description         String?        @db.Text
  category            String         @default("General")
  difficulty          TaskDifficulty @default(MEDIUM)
  status              QuizStatus     @default(DRAFT)
  timeLimitSec        Int            @default(180)
  passingScore        Int            @default(60)
  pointsReward        Int            @default(50)
  xpReward            Int            @default(25)
  cashReward          Decimal        @default(0) @db.Decimal(18, 6)
  maxAttempts         Int            @default(3)
  cooldownHours       Int            @default(24)
  requiredLevel       Int            @default(1)
  requiredAccessLevel Int?
  questions           QuizQuestion[]
  aiGenerated         Boolean        @default(false)
  aiPrompt            String?        @db.Text
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  attempts            QuizAttempt[]

  @@index([status])
  @@index([category])
  @@index([difficulty])
}

model QuizQuestion {
  id               String   @id @default(cuid())
  quizId           String
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order            Int      @default(0)
  question         String   @db.Text
  questionImageUrl String? // optional image shown as the question
  options          String[]
  optionImageUrls  String[] @default([]) // optional per-option images (index-aligned)
  correctIndex     Int
  explanation      String?  @db.Text
  pointsValue      Int      @default(10)

  @@index([quizId])
}

model QuizAttempt {
  id           String    @id @default(cuid())
  quizId       String
  quiz         Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId       String
  score        Int       @default(0)
  passed       Boolean   @default(false)
  answers      Json // user's answers per question
  timeTakenSec Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([quizId])
  @@index([userId])
  @@index([completedAt])
  @@index([quizId, userId])
}

enum MarketplaceListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
  PENDING_REVIEW
  REJECTED
}

enum MarketplaceBidStatus {
  ACTIVE // current high bid (only one ACTIVE per listing)
  OUTBID // a later, higher bid replaced this one
  WON // auction closed and this bid won
  LOST // auction closed and this bid didn't win
  CANCELLED
}

enum MarketplaceOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  WITHDRAWN
}

// Escrow "deal" lifecycle. A deal holds the buyer's funds until delivery is
// confirmed (or auto-released), instead of the instant-settle checkout path.
enum MarketplaceDealStatus {
  PROPOSED // terms proposed in a thread; awaiting acceptance + funding
  FUNDED // buyer funded escrow; funds held, awaiting delivery
  DELIVERED // seller marked delivered; awaiting buyer confirm / auto-release
  RELEASED // funds released to seller — completed
  REFUNDED // funds returned to buyer (clawback)
  CANCELLED // cancelled before funding
  DISPUTED // under admin mediation
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum CourseSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseLessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
  LIVE
  RESOURCE
}

enum QuizQuestionType {
  MCQ
  TRUE_FALSE
  MULTI_SELECT
}

enum AssignmentSubmissionStatus {
  PENDING
  GRADED
  RESUBMIT
}

enum LiveClassStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum CourseRefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  CATEGORY
  SPECIFIC_COURSES
}

enum TutorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LotteryStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

/// FIXED = `Lottery.prizes` holds absolute point amounts (how every lottery
/// worked before pool mode). POOL = the prize is derived from ticket sales at
/// draw time via `prizeTiers` percentages. See src/lib/lottery-prizes.ts.
enum LotteryPrizeMode {
  FIXED
  POOL
}

/// What happens when `minTickets` isn't reached by the draw date.
enum LotteryShortfallAction {
  /// Draw anyway with whatever accumulated.
  DRAW
  /// Cancel and return every ticket price.
  REFUND
  /// Move the pot to `rolloverTargetId`. Tickets are NOT refunded, so the
  /// user-facing page must say so before purchase.
  ROLLOVER
}

/// How a lottery ended. Recorded once on LotterySettlement.
enum LotteryOutcome {
  DRAWN
  REFUNDED
  ROLLED_OVER
  /// Nobody bought a ticket. Terminal — previously this left the lottery
  /// ACTIVE forever and the hourly sweep retried it on every run.
  VOID_NO_TICKETS
}

enum NotificationType {
  SYSTEM
  TASK
  WALLET
  REFERRAL
  PROMOTION
  ACHIEVEMENT
  LOTTERY
  SOCIAL
  COURSE
  MESSAGE
}

model User {
  id                                String                       @id @default(cuid())
  email                             String                       @unique
  emailVerified                     DateTime?
  phone                             String?
  phoneVerified                     DateTime?
  password                          String?
  name                              String?
  firstName                         String?
  lastName                          String?
  username                          String?                      @unique
  avatar                            String?
  coverPhoto                        String?
  bio                               String?
  country                           String?
  timezone                          String?                      @default("UTC")
  role                              UserRole                     @default(USER)
  // Optional super-admin-defined custom role (permissions come from it; the
  // user's `role` is kept as ADMIN as the admin-panel baseline). Null = plain role.
  customRoleId                      String?
  customRole                        CustomRole?                  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  status                            UserStatus                   @default(PENDING_VERIFICATION)
  pointsBalance                     Int                          @default(0)
  cashBalance                       Decimal                      @default(0) @db.Decimal(18, 6)
  // Non-withdrawable ad-spend wallet (USD, 1 credit = $1). Bought with cash/
  // points or admin-granted; campaign budgets are funded from this.
  adCreditBalance                   Decimal                      @default(0) @db.Decimal(18, 6)
  totalEarnings                     Decimal                      @default(0) @db.Decimal(18, 6)
  totalWithdrawals                  Decimal                      @default(0) @db.Decimal(18, 6)
  xp                                Int                          @default(0)
  level                             Int                          @default(1)
  streak                            Int                          @default(0)
  lastCheckIn                       DateTime?
  // Anti-fraud reputation: 0–100, starts neutral. Approvals nudge up, fraud
  // rejections nudge down; low trust forces manual review of otherwise
  // auto-approvable submissions (see src/lib/trust.ts).
  trustScore                        Int                          @default(50)
  fraudStrikes                      Int                          @default(0)
  packageId                         String?
  package                           Package?                     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageExpiresAt                  DateTime?
  kycStatus                         KYCStatus                    @default(NOT_SUBMITTED)
  kycSubmittedAt                    DateTime?
  kycApprovedAt                     DateTime?
  kycPromptedAt                     DateTime? // set once when we nudge a completed-profile user to do KYC
  // First-login onboarding (the @handle picker). Null = never completed, and the
  // Edge middleware sends the user to /welcome. Stamped by provisionUser for
  // paths that don't need it, by the onboarding action, and backfilled for every
  // account that existed before the screen shipped.
  onboardedAt                       DateTime?
  // When a Google identity was first linked to this row. Null = never linked, so
  // the next Google sign-in runs the one-time repair + stale-password revocation;
  // non-null = steady state, skip all of it. Without this the link branch can't
  // tell a first link from the 400th login of someone who later set a password
  // via Forgot Password — both look identical (`password != null`).
  googleLinkedAt                    DateTime?
  featureOverrides                  Json? // per-user feature grants/denials { [featureKey]: boolean } overriding the package
  permissionOverrides               Json? // per-user RBAC permission grants/denials { [permission]: boolean } on top of the role
  pageOverrides                     Json? // per-user page-visibility grants/denials { [path]: boolean } — super-admin page hiding
  // Anti-fraud: IP captured at signup + most recent request IP (per-IP account
  // cap + VPN/proxy heuristic). @@index on signupIp for the per-IP count.
  signupIp                          String?
  lastIp                            String?
  // When the user last changed a field that decides which targeted tasks they
  // are served (country/region/division/district/subDistrict/postalCode/gender/
  // dateOfBirth). All nine were freely editable with no limit and no trail, so
  // the play was: set your country to match a high-paying geo-targeted task,
  // complete it, set it back. See src/lib/profile-targeting.ts.
  targetingChangedAt                DateTime?
  isBlueVerified                    Boolean                      @default(false)
  // Visual style for the verified badge. Null/"BLUE" = classic blue tick.
  // Other presets (GOLD, RAINBOW, EMERALD, PURPLE, ROSE, OCEAN) render
  // a richer gradient — set by admin from the user-edit screen.
  verifiedBadgeStyle                String?                      @default("BLUE")
  twoFactorEnabled                  Boolean                      @default(false)
  twoFactorSecret                   String?
  referralCode                      String                       @unique
  referredById                      String?
  referredBy                        User?                        @relation("ReferralRelation", fields: [referredById], references: [id])
  referrals                         User[]                       @relation("ReferralRelation")
  // Affiliate program opt-in (earn commission promoting marketplace/course items).
  affiliateJoinedAt                 DateTime?
  affiliateCommissions              AffiliateCommission[]        @relation("AffiliateCommissions")
  // Events/quests progress (feature #10).
  eventProgress                     UserEventProgress[]
  missionProgress                   UserMissionProgress[]
  eventActionLogs                   EventActionLog[]
  socialRatioTallies                SocialRatioTally[]
  // Per-viewer boosted-post impression caps (feed boost frequency cap).
  postBoostViews                    PostBoostView[]
  // Extended profile fields (admin_oo.md §5.02)
  gender                            String?
  dateOfBirth                       DateTime?
  nidNumber                         String?
  profession                        String?
  maritalStatus                     String?
  studyLevel                        String?
  nationality                       String?
  bloodGroup                        String?
  secondaryEmail                    String?
  secondaryPhone                    String?
  // Extended address fields
  street                            String?
  village                           String?
  city                              String?
  subDistrict                       String?
  district                          String?
  subDivision                       String?
  division                          String?
  region                            String?
  postalCode                        String?
  // Profile tags (Early Adopter / Crypto / Trader / Pro / etc.) — max 3 picked from a fixed set
  tags                              String[]                     @default([])
  // Settings
  theme                             String                       @default("dark")
  themeAccent                       String?                      @default("indigo")
  language                          String                       @default("en")
  notificationsEnabled              Boolean                      @default(true)
  emailNotifications                Boolean                      @default(true)
  pushNotifications                 Boolean                      @default(true)
  // Privacy visibility ("PUBLIC" | "FRIENDS" | "PRIVATE") — defaults match spec
  privacyAvatar                     String                       @default("PUBLIC")
  privacyBio                        String                       @default("PUBLIC")
  privacyStats                      String                       @default("PUBLIC")
  privacyEarnings                   String                       @default("PRIVATE")
  privacyLocation                   String                       @default("FRIENDS")
  createdAt                         DateTime                     @default(now())
  updatedAt                         DateTime                     @updatedAt
  lastLoginAt                       DateTime?
  accounts                          Account[]
  sessions                          Session[]
  kycDocuments                      KYCDocument[]
  kycAppeals                        KYCAppeal[]
  taskSubmissions                   TaskSubmission[]
  transactions                      Transaction[]
  withdrawals                       Withdrawal[]
  paymentMethods                    UserPaymentMethod[]
  notifications                     Notification[]
  marketplaceListings               MarketplaceListing[]
  marketplacePurchases              MarketplacePurchase[]
  marketplaceWatches                MarketplaceWatch[]
  marketplaceViews                  MarketplaceListingView[]
  marketplaceBids                   MarketplaceBid[]
  marketplaceOffers                 MarketplaceOffer[]
  courseEnrollments                 CourseEnrollment[]
  tutorProfile                      TutorProfile?
  tutorApplications                 TutorApplication[]
  tutorApplicationsReviewed         TutorApplication[]           @relation("TutorAppReviewer")
  creatorApplications               CreatorApplication[]
  creatorApplicationsReviewed       CreatorApplication[]         @relation("CreatorAppReviewer")
  coursesTaught                     Course[]                     @relation("CourseTutor")
  courseReviews                     CourseReview[]
  courseQuestionsAsked              CourseQuestion[]             @relation("CourseQuestionAsker")
  courseQuestionsAnswered           CourseQuestion[]             @relation("CourseQuestionAnswerer")
  courseBookmarks                   CourseBookmark[]
  courseAnnouncements               CourseAnnouncement[]
  courseQuizAttempts                CourseQuizAttempt[]
  courseAssignmentSubmissions       CourseAssignmentSubmission[]
  courseAssignmentSubmissionsGraded CourseAssignmentSubmission[] @relation("AssignmentGrader")
  courseCertificates                CourseCertificate[]
  courseCoupons                     CourseCoupon[]
  courseRefundsRequested            CourseRefundRequest[]        @relation("CourseRefundUser")
  courseRefundsProcessed            CourseRefundRequest[]        @relation("CourseRefundAdmin")
  courseViews                       CourseListingView[]
  lotteryTickets                    LotteryTicket[]
  adCampaigns                       AdCampaign[]                 @relation("UserAdCampaigns")
  posts                             Post[]
  comments                          Comment[]
  likes                             Like[]
  badges                            UserBadge[]
  achievements                      UserAchievement[]
  referralEarnings                  ReferralEarning[]
  pointGifts                        PointGift[]                  @relation("PointGiftSender")
  receivedGifts                     PointGift[]                  @relation("PointGiftReceiver")
  mediaUploads                      Media[]
  cartItems                         CartItem[]
  votes                             Vote[]
  donations                         Donation[]
  ownedGroups                       Group[]                      @relation("GroupOwner")
  groupMemberships                  GroupMember[]
  groupJoinRequests                 GroupJoinRequest[]
  dailyMissionClaims                DailyMissionClaim[]
  dailyReferralClaims               DailyReferralClaim[]
  socialAccounts                    SocialAccount[]
  linkedAccounts                    LinkedPlatformAccount[]
  // Native social graph
  followers                         Follow[]                     @relation("Followers")
  following                         Follow[]                     @relation("Following")
  followerBoostBatches              FollowerBoostBatch[]         @relation("FollowerBoostTarget")
  followersCount                    Int                          @default(0)
  followingCount                    Int                          @default(0)
  // Admin-set vanity offsets. Display = max(0, real + boost).
  // Can be negative (admin can lower the visible count).
  displayFollowersBoost             Int                          @default(0)
  displayFollowingBoost             Int                          @default(0)
  displayPostsBoost                 Int                          @default(0)
  postViews                         PostView[]
  postLinkClicks                    PostLinkClick[]
  postShares                        PostShare[]
  socialActions                     SocialActionLog[]
  boardClaims                       BoardClaim[]
  articleKeys                       ArticleTaskKey[]
  mentionsReceived                  Mention[]                    @relation("Mentioned")
  mentionsMade                      Mention[]                    @relation("MentionedBy")

  // NB: email + referralCode are already @unique (own B-tree) — no extra @@index.
  @@index([referredById])
  @@index([status])
  @@index([role])
  @@index([signupIp])
  @@index([totalEarnings])
  @@index([referredById, createdAt])
  @@index([packageId])
  @@index([xp])
  // Demographic/location segmentation (ads, tasks, surveys, marketing, push).
  @@index([country])
  @@index([gender])
  @@index([division])
  @@index([district])
  @@index([subDistrict])
  @@index([city])
  @@index([region])
  @@index([language])
  @@index([dateOfBirth])
  @@index([country, gender])
  // Mention autocomplete + "who to follow" both sort on followersCount, which
  // had no index at all — a full sort of the users table.
  @@index([followersCount])
  @@index([status, followersCount])
  // FK index — present in the live database; declared here so schema and DB
  // agree and a future `db push` can't drop it.
  @@index([customRoleId])
}

model Account {
