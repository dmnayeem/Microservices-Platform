  rating       Int
  title        String?
  comment      String?  @db.Text
  helpfulCount Int      @default(0)
  reportedCount Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([courseId, userId])
  @@index([courseId])
}

model CourseQuestion {
  id            String    @id @default(cuid())
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId      String?
  askerId       String
  asker         User      @relation("CourseQuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  question      String    @db.Text
  answer        String?   @db.Text
  answeredById  String?
  answeredBy    User?     @relation("CourseQuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt    DateTime?
  isPinned      Boolean   @default(false)
  upvotes       Int       @default(0)
  createdAt     DateTime  @default(now())
  @@index([courseId])
  @@index([askerId])
}

model CourseBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
