  answers      Json
  fileUrls     String[]                   @default([])
  status       AssignmentSubmissionStatus @default(PENDING)
  marks        Int?
  feedback     String?                    @db.Text
  gradedById   String?
  gradedBy     User?                      @relation("AssignmentGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  submittedAt  DateTime                   @default(now())
