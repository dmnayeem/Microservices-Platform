// EarnGPT Database Schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  TUTOR
  SUPER_ADMIN
  FINANCE_ADMIN
  CONTENT_ADMIN
  SUPPORT_ADMIN
  MARKETING_ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum TaskType {
  VIDEO
  ARTICLE
  QUIZ
  SURVEY
  SOCIAL
  PROXY
  OFFERWALL
  CUSTOM
  APPINSTALL
}

enum TaskStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
  PENDING_REVIEW
  REJECTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
  REVISION_REQUESTED
}

enum TransactionType {
  EARNING
  WITHDRAWAL
  BONUS
  REFERRAL
  PURCHASE
  REFUND
  PENALTY
  GIFT
  LOTTERY_WIN
  CHECKIN
  COURSE_PURCHASE
  COURSE_TUTOR_EARNING
  COURSE_REFUND
  DEPOSIT
  AFFILIATE_COMMISSION
  ADMIN_FEE
}

// What earning generated a referral commission. Currently only tasks pay
// referral commissions; enumerated so new sources are added deliberately.
enum ReferralSourceType {
  TASK
  PURCHASE
  SUBSCRIPTION
  COURSE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BINANCE
  PAYPAL
}

// PackageTier enum removed in 2026-05 migration — use Package model + accessLevel instead.

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BannerLocation {
  HOME
  EARN_HUB
  MARKETPLACE
  DASHBOARD
  ALL
}

// HTML5 game catalog entry — admin supplies an icon + embed URL; users play it
// in a full-screen iframe with interstitial ads on open/resume/quit. No reward.
model Game {
  id          String   @id @default(cuid())
  title       String
  category    String?
  description String?  @db.Text
  iconUrl     String
  embedUrl    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  playsCount  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model Banner {
  id          String         @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String?
  videoUrl    String?        // optional background video (takes precedence over imageUrl)
  iconEmoji   String?
  bgGradient  String?        // e.g. "from-blue-600 to-purple-600"
  linkUrl     String?
  location    BannerLocation @default(HOME)
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([location])
  @@index([isActive])
  @@index([order])
  @@index([isActive, location])
}

/// Admin-built marketing "offer" pages, viewable by anyone at /offer/[slug].
model Offer {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String?  @db.Text
  thumbnailUrl String?
  bgGradient   String?
  blocks       Json     @default("[]")
  status       String   @default("DRAFT") // DRAFT | PUBLISHED
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model Campaign {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  type            String   // XP_MULTIPLIER | BONUS_POINTS | FREE_TICKETS | DISCOUNT | REFERRAL_BOOST | SEASONAL
  value           Float    @default(1)
  startDate       DateTime
  endDate         DateTime
  targetType      String   @default("ALL") // ALL | TIER | NEW_USERS | COUNTRY
  targetValue     String?
  budget          Decimal? @db.Decimal(18, 6)
  bannerImage     String?
  termsAndConditions String? @db.Text
  status          String   @default("SCHEDULED") // SCHEDULED | ACTIVE | PAUSED | ENDED
  participantCount Int     @default(0)
  rewardsDistributed Decimal @default(0) @db.Decimal(18, 6)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([startDate, endDate])
}

model Mission {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  type          String   // TASK_COMPLETION | LOGIN_STREAK | REFERRAL | SPEND | EARN
  targetValue   Int
  pointsReward  Int      @default(0)
  cashReward    Decimal    @default(0) @db.Decimal(18, 6)
  xpReward      Int      @default(0)
  duration      String   @default("DAILY") // DAILY | WEEKLY
  autoRefresh   Boolean  @default(true)
  requiredLevel Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([duration])
}

// Daily Task Mission — admin-defined per-package mission template that bundles
// several "complete N tasks of type X" buckets. Users see today's mission for
// their tier, work through every bucket, then claim the final reward.
model DailyMissionTemplate {
  id                      String      @id @default(cuid())
  name                    String
  description             String?     @db.Text
  requiredAccessLevel     Int         @default(0)
  requiredLevel           Int         @default(1)
  completionXpReward      Int         @default(0)
  completionPointsReward  Int         @default(0)
  isActive                Boolean     @default(true)
  autoRefresh             Boolean     @default(true)
  linkReferralBonus       Boolean     @default(false)
  order                   Int         @default(0)
  createdById             String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  items   DailyMissionItem[]
  claims  DailyMissionClaim[]

  @@index([requiredAccessLevel])
  @@index([isActive])
}

model DailyMissionItem {
  id                String               @id @default(cuid())
  missionId         String
  mission           DailyMissionTemplate @relation(fields: [missionId], references: [id], onDelete: Cascade)
  taskType          String               // ARTICLE | VIDEO | QUIZ | SURVEY | SOCIAL | PROXY | OFFERWALL | BOARD | MANUAL | CUSTOM
  description       String?              @db.Text
  targetCount       Int                  @default(1)
  xpPerComplete     Int                  @default(0)
  pointsPerComplete Int                  @default(0)
  duration          Int?                 // minutes (display-only)
  requiredLevel     Int?
  order             Int                  @default(0)

  @@index([missionId])
}

model DailyMissionClaim {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String
  mission     DailyMissionTemplate  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  date        String                // YYYY-MM-DD (UTC)
  streak      Int                   @default(1)
  claimedAt   DateTime              @default(now())

  @@unique([userId, missionId, date])
  @@index([userId, date])
  @@index([missionId])
}

model DailyReferralClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD (UTC)
  amount    Decimal @db.Decimal(18, 6)
  points    Int
  claimedAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model AdCampaign {
  id            String   @id @default(cuid())
  advertiserId  String?
  advertiser    User?    @relation("UserAdCampaigns", fields: [advertiserId], references: [id], onDelete: SetNull)
  title         String
  description   String?  @db.Text
  budget        Decimal    @default(0) @db.Decimal(18, 6)
  status        String   @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  // Optional flight window — ads only serve while now is within [startAt, endAt].
  startAt       DateTime?
  endAt         DateTime?
  ads           Ad[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([advertiserId])
  @@index([status])
  @@index([status, startAt, endAt])
}

model AdPlacement {
  id        String   @id @default(cuid())
  name      String   @unique
  platform  String   @default("ALL")
  isActive  Boolean  @default(true)
  // Per-space ad-rotation interval (seconds). Null = use the global
  // `ads.rotation_seconds` setting. Clamped 5–60 when set.
  rotationSeconds Int?
  // Per-space interstitial ad duration (seconds) — how long the full-screen ad
  // shows before it can be closed. Null = default 5s. Clamped 3–60 when set.
  interstitialSeconds Int?
  ads       Ad[]
  createdAt DateTime @default(now())
}

model AdNetwork {
  id              String   @id @default(cuid())
  name            String
  providerKey     String   @unique
  initScript      String?  @db.Text
  isEnabledWeb    Boolean  @default(true)
  isEnabledMobile Boolean  @default(true)
  globalWeight    Int      @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Ad {
  id          String      @id @default(cuid())
  campaignId  String
  campaign    AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placementId String
  placement   AdPlacement @relation(fields: [placementId], references: [id])
  type        String      @default("LOCAL")
  format      String      @default("BANNER") // BANNER | NATIVE (feed post-like)
  contentUrl  String?     // image / GIF creative URL
  videoUrl    String?     // MP4/WebM video creative URL
  targetUrl   String?
  htmlContent String?     @db.Text
  // Creative size — preset key (see src/lib/ad-sizes.ts); width/height used for "custom"
  size        String?     @default("responsive")
  width       Int?
  height      Int?
  weight      Int         @default(10)
  // ACTIVE | PAUSED | INACTIVE | PENDING (awaiting admin review) | REJECTED
  status      String      @default("ACTIVE")
  // Review workflow (advertiser-submitted ads land as PENDING until an admin acts)
  submittedById   String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?  @db.Text
  impressions Int         @default(0)
  clicks      Int         @default(0)
  // Native (post-like) creative fields — used when format = NATIVE
  headline    String?     @db.Text     // post-like ad copy
  brandName   String?                  // shown as author name
  brandLogo   String?                  // author avatar URL
  ctaLabel    String?                  // CTA button label (e.g. "Learn More")
  // Promote-a-real-post: when set, the native ad renders this post + its author
  promotedPostId String?
  promotedPost   Post?    @relation("PostAds", fields: [promotedPostId], references: [id], onDelete: SetNull)
  // Simple targeting: { countries?, genders?, minLevel?, packages? } (null = everyone)
  targeting   Json?
  // Viewer-reward (watch-and-earn)
  rewardPoints      Int    @default(0)
  rewardCooldownSec Int    @default(3600)
  watchSeconds      Int    @default(15)
  views       AdView[]
  dailyStats  AdDailyStat[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([campaignId])
  @@index([placementId])
  @@index([status])
  @@index([promotedPostId])
  @@index([placementId, status])
}

// Per-day rollup of ad impressions/clicks/spend for time-series analytics.
model AdDailyStat {
  id          String   @id @default(cuid())
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spendUsd    Decimal    @default(0) @db.Decimal(18, 6)

  @@unique([adId, date])
  @@index([adId, date])
}

model AdView {
  id             String   @id @default(cuid())
  userId         String
  adId           String
  ad             Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  rewardedPoints Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId, adId])
  @@index([userId, createdAt])
  @@index([adId])
  @@index([userId, adId, createdAt])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Deposit {
  id         String   @id @default(cuid())
  userId     String
  amount     Decimal @db.Decimal(18, 6)
  method     String   // MANUAL_BKASH | MANUAL_NAGAD | SSLCOMMERZ | ...
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  gatewayRef String?
  // Manual deposit provider txn id — unique so the same payment can't be
  // submitted/approved twice (double-credit).
  txnId      String?  @unique
  proofUrl   String?
  adminNote  String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model FraudEvent {
  id          String        @id @default(cuid())
  userId      String?
  eventType   String   // MULTIPLE_ACCOUNTS, VPN_DETECTED, etc.
  severity    FraudSeverity @default(MEDIUM)
  details     Json?
  ipAddress   String?
  userAgent   String?
  status      String   @default("OPEN") // OPEN | DISMISSED | ACTED
  resolverNote String? @db.Text
  resolvedById String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model ProxyServer {
  id              String   @id @default(cuid())
  name            String
  host            String
  port            Int
  protocol        String   @default("HTTPS") // HTTP | HTTPS | SOCKS5
  country         String?  // ISO code
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE | ERROR
  loadPercent     Int      @default(0)
  maxConcurrent   Int      @default(50)
  bandwidthMbUser Int      @default(100)
  responseTimeMs  Int?
  lastHealthCheck DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([country])
}

model OfferwallCallback {
  id            String   @id @default(cuid())
  userId        String
  offerwallId   String
  offerId       String?
  offerName     String?
  transactionId String   @unique
  payoutAmount  Decimal @db.Decimal(18, 6)
  userPayout    Int     // points
  currency      String   @default("USD")
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | FRAUD | CHARGEBACK
  fraudScore    Int     @default(0)
  fraudReasons  String[]
  ipAddress     String?
  userAgent     String?  @db.Text
  countryCode   String?
  deviceType    String?
  rawPayload    Json?
  reviewedById  String?
  reviewNote    String?  @db.Text
  rejectionReason String? @db.Text
  processedAt   DateTime?
  creditedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([offerwallId])
  @@index([userId])
  @@index([createdAt])
}

model TaskBoard {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  iconEmoji    String?
  imageUrl     String?
  // "Marketing" | "Development" | "Design" | "Sales" | "Learning" | "Other"
  category     String?
  // null = no deadline
  expiresAt    DateTime?
  pointsReward Int      @default(0)
  xpReward     Int      @default(0)
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  // Optional prerequisite board — user must claim this board first to unlock.
  unlockBoardId String?
  unlockBoard   TaskBoard?  @relation("BoardUnlockChain", fields: [unlockBoardId], references: [id], onDelete: SetNull)
  unlocks       TaskBoard[] @relation("BoardUnlockChain")
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks   Task[]
  claims  BoardClaim[]

  @@index([isActive])
  @@index([order])
  @@index([category])
  @@index([unlockBoardId])
}

// Per-user record of a Task Board reward claim. One row per (user, board);
// uniqueness enforced at the DB level so re-claims are impossible regardless
// of races. Created inside the same transaction as the EARNING transaction
// so the two stay consistent.
model BoardClaim {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId       String
  board         TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  pointsEarned  Int       @default(0)
  xpEarned      Int       @default(0)
  taskCount     Int       @default(0)
  claimedAt     DateTime  @default(now())
  transactionId String?

  @@unique([userId, boardId])
  @@index([boardId, claimedAt])
  @@index([userId])
}

model SocialReport {
  id          String   @id @default(cuid())
  contentType String   // POST | COMMENT | USER | LISTING
  contentId   String
  reporterId  String
  reason      String   // SPAM | HARASSMENT | FRAUD | INAPPROPRIATE | OTHER
  details     String?  @db.Text
  priority    String   @default("NORMAL") // URGENT | HIGH | NORMAL
  status      String   @default("PENDING") // PENDING | RESOLVED
  resolution  String?  // DISMISSED | WARNED | SUSPENDED | BANNED | DELETED
  resolverNote String? @db.Text
  resolvedById String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([contentType])
  @@index([reporterId])
  @@index([createdAt])
  @@index([status, contentType])
  @@index([contentType, contentId])
}

model Quiz {
  id              String         @id @default(cuid())
  title           String
  description     String?        @db.Text
  category        String         @default("General")
  difficulty      TaskDifficulty @default(MEDIUM)
  status          QuizStatus     @default(DRAFT)
  timeLimitSec    Int            @default(180)
  passingScore    Int            @default(60)
  pointsReward    Int            @default(50)
  xpReward        Int            @default(25)
  cashReward      Decimal          @default(0) @db.Decimal(18, 6)
  maxAttempts     Int            @default(3)
  cooldownHours   Int            @default(24)
  requiredLevel   Int            @default(1)
  requiredAccessLevel Int?
  questions       QuizQuestion[]
  aiGenerated     Boolean        @default(false)
  aiPrompt        String?        @db.Text
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  attempts        QuizAttempt[]

  @@index([status])
  @@index([category])
  @@index([difficulty])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order            Int      @default(0)
  question         String   @db.Text
  questionImageUrl String?              // optional image shown as the question
  options          String[]
  optionImageUrls  String[] @default([]) // optional per-option images (index-aligned)
  correctIndex     Int
  explanation      String?  @db.Text
  pointsValue      Int      @default(10)

  @@index([quizId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  score       Int       @default(0)
  passed      Boolean   @default(false)
  answers     Json      // user's answers per question
  timeTakenSec Int      @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([quizId])
  @@index([userId])
  @@index([completedAt])
  @@index([quizId, userId])
}

enum MarketplaceListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
  PENDING_REVIEW
  REJECTED
}

enum MarketplaceBidStatus {
  ACTIVE // current high bid (only one ACTIVE per listing)
  OUTBID // a later, higher bid replaced this one
  WON    // auction closed and this bid won
  LOST   // auction closed and this bid didn't win
  CANCELLED
}

enum MarketplaceOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  WITHDRAWN
}

// Escrow "deal" lifecycle. A deal holds the buyer's funds until delivery is
// confirmed (or auto-released), instead of the instant-settle checkout path.
enum MarketplaceDealStatus {
  PROPOSED  // terms proposed in a thread; awaiting acceptance + funding
  FUNDED    // buyer funded escrow; funds held, awaiting delivery
  DELIVERED // seller marked delivered; awaiting buyer confirm / auto-release
  RELEASED  // funds released to seller — completed
  REFUNDED  // funds returned to buyer (clawback)
  CANCELLED // cancelled before funding
  DISPUTED  // under admin mediation
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum CourseSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseLessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
  LIVE
  RESOURCE
}

enum QuizQuestionType {
  MCQ
  TRUE_FALSE
  MULTI_SELECT
}

enum AssignmentSubmissionStatus {
  PENDING
  GRADED
  RESUBMIT
}

enum LiveClassStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum CourseRefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  CATEGORY
  SPECIFIC_COURSES
}

enum TutorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LotteryStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  TASK
  WALLET
  REFERRAL
  PROMOTION
  ACHIEVEMENT
  LOTTERY
  SOCIAL
  COURSE
  MESSAGE
}
model User {
  id                String      @id @default(cuid())
  email             String      @unique
  emailVerified     DateTime?
  phone             String?
  phoneVerified     DateTime?
  password          String?
  name              String?
  firstName         String?
  lastName          String?
  username          String?     @unique
  avatar            String?
  coverPhoto        String?
  bio               String?
  country           String?
  timezone          String?     @default("UTC")
  role              UserRole    @default(USER)
  status            UserStatus  @default(PENDING_VERIFICATION)
  pointsBalance     Int         @default(0)
  cashBalance       Decimal     @default(0) @db.Decimal(18, 6)
  totalEarnings     Decimal     @default(0) @db.Decimal(18, 6)
  totalWithdrawals  Decimal     @default(0) @db.Decimal(18, 6)
  xp                Int         @default(0)
  level             Int         @default(1)
  streak            Int         @default(0)
  lastCheckIn       DateTime?
  // Anti-fraud reputation: 0–100, starts neutral. Approvals nudge up, fraud
  // rejections nudge down; low trust forces manual review of otherwise
  // auto-approvable submissions (see src/lib/trust.ts).
  trustScore        Int         @default(50)
  fraudStrikes      Int         @default(0)
  packageId         String?
  package           Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageExpiresAt  DateTime?
  kycStatus         KYCStatus   @default(NOT_SUBMITTED)
  kycSubmittedAt    DateTime?
  kycApprovedAt     DateTime?
  kycPromptedAt     DateTime?   // set once when we nudge a completed-profile user to do KYC
  featureOverrides  Json?       // per-user feature grants/denials { [featureKey]: boolean } overriding the package
  isBlueVerified    Boolean     @default(false)
  // Visual style for the verified badge. Null/"BLUE" = classic blue tick.
