# No `file_server` on the app: Caddy only proxies, so directory listing is
# impossible by construction. Next.js serves only public/ and .next/static;
# .env, src/ and the rest of the repo are unreachable by any URL.
{
	email noreply@revtype.com
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
			103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 \
			188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 \
			104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	encode zstd gzip

	@dotfiles path_regexp dotfile (^|/)\.
	respond @dotfiles 404

	@forbidden path /Dockerfile /docker-compose.yml /Caddyfile /*.sh \
		/package.json /package-lock.json /tsconfig.json /next.config.ts \
		/prisma/* /src/* /node_modules/*
	respond @forbidden 404

	# Service worker, served from the copy deploy.sh stamps with the build id.
	# A new build therefore ships a NEW service worker, whose activate() drops
	# every cache the previous build left behind. Never cached by browser or
	# edge, so the update is seen on the very next check. Falls back to the
	# app until the first stamped copy exists.
	handle /sw.js {
		root * /srv/sw
		@stamped file
		route @stamped {
			header Cache-Control "no-cache, max-age=0, must-revalidate"
			header Content-Type "application/javascript; charset=utf-8"
			file_server
		}
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}

	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		# While deploy.sh recreates the app container (a few seconds), hold the
		# request and retry instead of answering 502 at once. A 502 on a page's
		# CSS is what showed the site as bare, unstyled HTML right after a
		# deploy, and on a JS chunk it was "Something went wrong / Try again".
		lb_try_duration 45s
		lb_try_interval 250ms
	}

	request_body {
		max_size 100MB
	}

	# Vercel parity for browsers. Next emits `s-maxage=N, stale-while-revalidate`
	# on ISR pages - a hint meant for a CDN - and Vercel rewrites it to
	# max-age=0 before any browser sees it. Self-hosted Next sends it raw and
	# Chrome will serve the stale copy first. `>` defers this until the upstream
	# response exists; the regex matches only those ISR headers, so no-store
	# pages and immutable assets are untouched.
	header >Cache-Control "^s-maxage=\d+, stale-while-revalidate=\d+$" "public, max-age=0, must-revalidate"

	header {
		-Server
		-X-Powered-By
	}

	log {
		output stdout
		format json
	}
}

# Third-party ad frames ONLY (AD_FRAME_ORIGIN, src/lib/ad-networks/frame.ts).
# Network ad code (Adsterra...) needs cookies / localStorage, which a locked
# srcDoc frame cannot give it, so its ads stayed blank. Here it gets an origin
# of its own. Exactly one path is served; the app itself is never reachable on
# this host, and middleware refuses any request this origin sends to the app.
ads.{$APP_DOMAIN} {
	# Never in search results. Every response (frame, 404) says noindex; no
	# robots.txt Disallow on purpose - a blocked crawler never sees the header.
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

	handle /api/ads/frame/* {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	handle {
		respond 404
	}
	request_body {
		max_size 1MB
	}
	header -Server
}

# Amazon SNS -> SES bounce/complaint webhook ONLY.
# DNS-only (grey cloud) host: Cloudflare's Bot Fight Mode answers Amazon SNS
# with a JS challenge, which a server can't solve, and Free plans can't exempt
# one path from it. This host bypasses Cloudflare and serves exactly one path;
# the route itself verifies every SNS signature and the topic ARN.
hooks.{$APP_DOMAIN} {
	handle /api/email/ses-events {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	handle {
		respond 404
	}
	request_body {
		max_size 1MB
	}
	header -Server
}
