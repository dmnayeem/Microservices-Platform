# No `file_server` anywhere in this file: Caddy only ever proxies. Directory
# listing is therefore impossible by construction, not switched off. Next.js
# serves only public/ and .next/static; .env, Dockerfile, src/ and the rest
# of the repo are unreachable by any URL. The denials below are belt-and-braces
# for scanners, which start hitting a box within hours of DNS resolving.
{
	email noreply@revtype.com
	servers {
		# Real visitor IP from Cloudflare, so rate limiting and geoip in the
		# app see the visitor, not a Cloudflare edge address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
			103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 \
			188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 \
			104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Caddy issues the certificate, renews it, redirects http???https (308) and
# answers the ACME challenge on :80 ??? all automatic. No separate :80 block;
# one would shadow the implicit site Caddy uses for exactly those two jobs.
{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	encode zstd gzip

	@dotfiles path_regexp dotfile (^|/)\.
	respond @dotfiles 404

	@forbidden path /Dockerfile /docker-compose.yml /Caddyfile /*.sh \
		/package.json /package-lock.json /tsconfig.json /next.config.ts \
		/prisma/* /src/* /node_modules/*
	respond @forbidden 404

	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	request_body {
		max_size 100MB
	}

	header {
		-Server
		-X-Powered-By
	}

	log {
		output stdout
		format json
	}
}
